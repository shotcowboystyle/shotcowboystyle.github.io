---
import BackLink from '@/components/back-link.astro';
import GameLayout from '@/layouts/game.astro';

const meta = {
	title: 'Tower Blocks — Curtis Blanton',
	description:
		'A stacking game, built with Three.js and Cannon.js. Click or press space to place the block.',
};
---

<GameLayout meta={meta}>
	<div id="container">
		<div id="game"></div>

		<div class="chrome-top">
			<BackLink tone="canvas" />

			{
				/*
				 * `aria-live="polite"` with `aria-atomic`: the score is the only
				 * feedback a player gets for a successful placement, and without a
				 * live region it changed silently for anyone not watching the numeral.
				 */
			}
			<p
				id="score"
				aria-live="polite"
				aria-atomic="true"
			>
				<span class="visually-hidden">Score:</span><span id="score-value">0</span>
			</p>
		</div>

		<div class="plate-slot">
			<div class="game-ready plate plate-canvas">
				<p class="plate-label">Interlude</p>
				<h1 id="start-message">In case you were bored</h1>
				<p class="plate-body">
					Drop each slab on the one below it. Whatever hangs over the edge gets cut off and falls.
					Miss entirely and the tower is finished.
				</p>
				<button
					type="button"
					id="start-button"
					class="plate-action"
				>
					Start stacking
				</button>
			</div>

			{
				/*
				 * `role="status"` rather than a bare div: the end of a run is a state
				 * change with no focus move, so it has to be announced.
				 */
			}
			<div
				class="game-over plate plate-mint"
				role="status"
			>
				<p class="plate-label">Tower down</p>
				<h2>You stacked <span id="final-score">0</span></h2>
				<p class="plate-body">Click, tap, or press the space bar to start again.</p>
			</div>
		</div>

		<p id="instructions">Click or press the space bar to place the block</p>
	</div>
</GameLayout>

<script>
	import * as CANNON from 'cannon';
	import * as THREE from 'three';

	type BlockPlane = 'x' | 'y' | 'z';
	interface GeneratedBlock {
		threejs: THREE.Mesh;
		cannonjs: CANNON.Body;
		width: number;
		depth: number;
		direction?: BlockPlane;
	}

	const BOX_HEIGHT = 3; // Height of each layer
	const ORIGINAL_BOX_SIZE = 9; // Original width and height of a box
	const GAME_STATES = {
		LOADING: 'loading',
		PLAYING: 'playing',
		READY: 'ready',
		ENDED: 'ended',
		RESETTING: 'resetting',
	};

	/**
	 * Signal Mint · Cobalt Draft · Lavender Wash, measured off the `oklch()`
	 * tokens in `base.css`. The old ramp was `hsl(30 + n * 4, 100%, 50%)` — a
	 * saturated orange run that shared nothing with the rest of the site.
	 *
	 * Layers walk the ramp forward and then back again over sixteen layers, so
	 * the tower reads as a printed color bar climbing rather than a wheel spin,
	 * and there is no hard seam where the cycle restarts.
	 */
	const BLOCK_RAMP = ['#20d48c', '#377bf9', '#aaacdd'] as const;
	const RAMP_PERIOD = 16;
	const CLEAR_COLOR = '#000000';

	function blockColor(layerIndex: number): THREE.Color {
		const span = BLOCK_RAMP.length - 1;
		const cycle = (layerIndex % RAMP_PERIOD) / (RAMP_PERIOD / 2);
		const triangle = cycle <= 1 ? cycle : 2 - cycle;
		const position = triangle * span;
		const stop = Math.min(Math.floor(position), span - 1);

		return new THREE.Color(BLOCK_RAMP[stop]).lerp(
			new THREE.Color(BLOCK_RAMP[stop + 1]),
			position - stop,
		);
	}

	// ThreeJS globals
	let camera: THREE.OrthographicCamera;
	let scene: THREE.Scene;
	let renderer: THREE.WebGLRenderer;

	let world: CANNON.World; // CannonJs world
	let lastTime: number; // Last timestamp of animation
	let stack: GeneratedBlock[]; // Parts that stay solid on top of each other
	let overhangs: GeneratedBlock[]; // Overhanging parts that fall down
	let gameState: (typeof GAME_STATES)[keyof typeof GAME_STATES];

	let scoreElement: HTMLElement | null;
	let finalScoreElement: HTMLElement | null;
	let pageContainerElement: HTMLElement | null;

	function setScore(value: number) {
		if (scoreElement) {
			scoreElement.innerText = String(value);
		}
		if (finalScoreElement) {
			finalScoreElement.innerText = String(value);
		}
	}

	function generateBlock(
		x: number,
		y: number,
		z: number,
		width: number,
		depth: number,
		falls: boolean,
		layerIndex: number,
	): GeneratedBlock {
		// ThreeJS
		const geometry = new THREE.BoxGeometry(width, BOX_HEIGHT, depth);
		const material = new THREE.MeshLambertMaterial({ color: blockColor(layerIndex) });
		const mesh = new THREE.Mesh(geometry, material);
		mesh.position.set(x, y, z);
		scene.add(mesh);

		// CannonJS
		const shape = new CANNON.Box(new CANNON.Vec3(width / 2, BOX_HEIGHT / 2, depth / 2));

		let mass = falls ? 5 : 0; // If it shouldn't fall then setting the mass to zero will keep it stationary
		mass *= width / ORIGINAL_BOX_SIZE; // Reduce mass proportionately by size
		mass *= depth / ORIGINAL_BOX_SIZE; // Reduce mass proportionately by size

		const body = new CANNON.Body({ mass, shape });
		body.position.set(x, y, z);
		world.addBody(body);

		return {
			threejs: mesh,
			cannonjs: body,
			width,
			depth,
		};
	}

	function addLayer(x: number, z: number, width: number, depth: number, direction?: BlockPlane) {
		const y = BOX_HEIGHT * stack.length; // Add the new box one layer higher
		const layer = generateBlock(x, y, z, width, depth, false, stack.length);
		layer.direction = direction;
		stack.push(layer);

		if (stack.length >= 5) {
			const instructionsElement = document.getElementById('instructions');
			if (instructionsElement) {
				instructionsElement.classList.add('hide');
			}
		}
	}

	/**
	 * Takes the color of the layer it was cut from — `stack.length` is one past
	 * that layer's index, so the offcut used to be tinted as if it were the next
	 * layer up and visibly mismatched the slab it fell off.
	 */
	function addOverhang(x: number, z: number, width: number, depth: number) {
		const y = BOX_HEIGHT * (stack.length - 1); // Add the new box one the same layer
		const overhang = generateBlock(x, y, z, width, depth, true, stack.length - 1);
		overhangs.push(overhang);
	}

	function missedTheSpot() {
		const topLayer = stack[stack.length - 1];

		// Turn to top layer into an overhang and let it fall down
		addOverhang(
			topLayer.threejs.position.x,
			topLayer.threejs.position.z,
			topLayer.width,
			topLayer.depth,
		);
		world.remove(topLayer.cannonjs);

		// Properly dispose of Three.js resources
		if (topLayer.threejs.geometry) {
			topLayer.threejs.geometry.dispose();
		}
		if (topLayer.threejs.material) {
			if (Array.isArray(topLayer.threejs.material)) {
				topLayer.threejs.material.forEach((material) => material.dispose());
			} else {
				topLayer.threejs.material.dispose();
			}
		}
		scene.remove(topLayer.threejs);

		updateState(GAME_STATES.ENDED);
	}

	function updatePhysics(timePassed: number) {
		world.step(timePassed / 1000); // Step the physics world

		// Copy coordinates from Cannon.js to Three.js
		overhangs.forEach((element) => {
			element.threejs.position.copy({ ...element.cannonjs.position } as THREE.Vector3);
			element.threejs.quaternion.copy({ ...element.cannonjs.quaternion } as THREE.Quaternion);
		});
	}

	function animation(time: number) {
		if (lastTime) {
			const timePassed = time - lastTime;
			const speed = 0.005;

			const topLayer = stack[stack.length - 1];

			// The top level box should move if the game has not ended AND
			// it's either NOT in autopilot or it is in autopilot and the box did not yet reach the robot position
			const boxShouldMove = gameState !== GAME_STATES.ENDED;

			if (boxShouldMove) {
				// Keep the position visible on UI and the position in the model in sync
				topLayer.threejs.position[topLayer.direction as BlockPlane] += speed * timePassed;
				topLayer.cannonjs.position[topLayer.direction as BlockPlane] += speed * timePassed;

				// If the box went beyond the stack then show up the fail screen
				if (topLayer.threejs.position[topLayer.direction as BlockPlane] > 10) {
					missedTheSpot();
				}
			}

			// 4 is the initial camera height
			if (camera.position.y < BOX_HEIGHT * (stack.length - 2) + 4) {
				camera.position.y += speed * timePassed;
			}

			updatePhysics(timePassed);
			renderer.render(scene, camera);
		}

		lastTime = time;
	}

	function updateState(newState: string) {
		if (pageContainerElement) {
			for (const state of Object.values(GAME_STATES)) {
				pageContainerElement?.classList.remove(state);
			}

			pageContainerElement?.classList.add(newState);
			gameState = newState;
		}
	}

	function cutBox(topLayer: GeneratedBlock, overlap: number, size: number, delta: number) {
		const direction = topLayer.direction;
		const newWidth = direction === 'x' ? overlap : topLayer.width;
		const newDepth = direction === 'z' ? overlap : topLayer.depth;

		// Update metadata
		topLayer.width = newWidth;
		topLayer.depth = newDepth;

		// Update ThreeJS model
		topLayer.threejs.scale[direction as BlockPlane] = overlap / size;
		topLayer.threejs.position[direction as BlockPlane] -= delta / 2;

		// Update CannonJS model
		topLayer.cannonjs.position[direction as BlockPlane] -= delta / 2;

		// Replace shape to a smaller one (in CannonJS you can't simply just scale a shape)
		const shape = new CANNON.Box(new CANNON.Vec3(newWidth / 2, BOX_HEIGHT / 2, newDepth / 2));

		topLayer.cannonjs.shapes = [];
		topLayer.cannonjs.addShape(shape);
	}

	function splitBlockAndAddNextOneIfOverlaps() {
		if (gameState === GAME_STATES.ENDED) {
			return;
		}

		const topLayer = stack[stack.length - 1];
		const previousLayer = stack[stack.length - 2];

		const direction = topLayer.direction;

		const size = direction === 'x' ? topLayer.width : topLayer.depth;
		const delta =
			topLayer.threejs.position[direction as BlockPlane] -
			previousLayer.threejs.position[direction as BlockPlane];
		const overhangSize = Math.abs(delta);
		const overlap = size - overhangSize;

		if (overlap > 0) {
			cutBox(topLayer, overlap, size, delta);

			// Overhang
			const overhangShift = (overlap / 2 + overhangSize / 2) * Math.sign(delta);
			const overhangX =
				direction === 'x'
					? topLayer.threejs.position.x + overhangShift
					: topLayer.threejs.position.x;
			const overhangZ =
				direction === 'z'
					? topLayer.threejs.position.z + overhangShift
					: topLayer.threejs.position.z;
			const overhangWidth = direction === 'x' ? overhangSize : topLayer.width;
			const overhangDepth = direction === 'z' ? overhangSize : topLayer.depth;

			addOverhang(overhangX, overhangZ, overhangWidth, overhangDepth);

			// Next layer
			const nextX = direction === 'x' ? topLayer.threejs.position.x : -10;
			const nextZ = direction === 'z' ? topLayer.threejs.position.z : -10;
			const newWidth = topLayer.width; // New layer has the same size as the cut top layer
			const newDepth = topLayer.depth; // New layer has the same size as the cut top layer
			const nextDirection = direction === 'x' ? 'z' : 'x';

			setScore(stack.length - 1);

			addLayer(nextX, nextZ, newWidth, newDepth, nextDirection);
		} else {
			missedTheSpot();
		}
	}

	function startGame() {
		updateState(GAME_STATES.PLAYING);

		lastTime = 0;
		stack = [];
		overhangs = [];

		setScore(0);

		if (world) {
			// Remove every object from world
			while (world.bodies.length > 0) {
				world.remove(world.bodies[0]);
			}
		}

		if (scene) {
			// Remove every Mesh from the scene and dispose of resources
			while (scene.children.find((c) => c.type === 'Mesh')) {
				const mesh = scene.children.find((c) => c.type === 'Mesh') as THREE.Mesh | undefined;
				if (mesh) {
					// Dispose of geometry
					if (mesh.geometry) {
						mesh.geometry.dispose();
					}
					// Dispose of material(s)
					if (mesh.material) {
						if (Array.isArray(mesh.material)) {
							mesh.material.forEach((material) => material.dispose());
						} else {
							mesh.material.dispose();
						}
					}
					scene.remove(mesh);
				}
			}

			// Foundation
			addLayer(0, 0, ORIGINAL_BOX_SIZE, ORIGINAL_BOX_SIZE);

			// First layer
			addLayer(-10, 0, ORIGINAL_BOX_SIZE, ORIGINAL_BOX_SIZE, 'x');
		}

		if (camera) {
			// Reset camera positions
			camera.position.set(4, 4, 4);
			camera.lookAt(0, 0, 0);
		}
	}

	function init() {
		lastTime = 0;
		stack = [];
		overhangs = [];

		// Initialize CannonJS
		world = new CANNON.World();
		world.gravity.set(0, -10, 0); // Gravity pulls things down
		world.broadphase = new CANNON.NaiveBroadphase();
		world.solver.iterations = 40;

		// Initialize ThreeJs
		const aspect = window.innerWidth / window.innerHeight;
		const width = 20;
		const height = width / aspect;

		camera = new THREE.OrthographicCamera(
			width / -2, // left
			width / 2, // right
			height / 2, // top
			height / -2, // bottom
			-100, // near plane
			1000, // far plane
		);

		camera.position.set(4, 4, 4);
		camera.lookAt(0, 0, 0);

		scene = new THREE.Scene();

		// Foundation
		addLayer(0, 0, ORIGINAL_BOX_SIZE, ORIGINAL_BOX_SIZE);

		/*
		 * Lifted from 0.6/0.6. On the black canvas the slabs no longer sit against
		 * a light ground bouncing fill back at them, so the unlit faces were
		 * closing up into the background and the tower lost its silhouette.
		 */
		const ambientLight = new THREE.AmbientLight(0xffffff, 0.75);
		scene.add(ambientLight);

		const dirLight = new THREE.DirectionalLight(0xffffff, 0.9);
		dirLight.position.set(10, 20, 0);
		scene.add(dirLight);

		// Set up renderer
		const gameContainerElement = document.getElementById('game');
		if (gameContainerElement) {
			renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
			// Capped at 2: past that the extra pixels are invisible and the fill cost is not.
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
			renderer.setSize(window.innerWidth, window.innerHeight);
			renderer.setClearColor(CLEAR_COLOR, 1);
			renderer.setAnimationLoop(animation);
			gameContainerElement.appendChild(renderer.domElement);

			updateState(GAME_STATES.READY);
		}
	}

	function handleOnKeydown(event: KeyboardEvent) {
		if (event.key === ' ' || event.code === 'Space') {
			event.preventDefault();
			if ([GAME_STATES.READY, GAME_STATES.ENDED].includes(gameState)) {
				startGame();
			} else {
				splitBlockAndAddNextOneIfOverlaps();
			}
		}
	}

	function handleOnResize() {
		// Adjust camera
		const aspect = window.innerWidth / window.innerHeight;
		const width = 20;
		const height = width / aspect;

		camera.top = height / 2;
		camera.bottom = height / -2;
		/*
		 * Without this the new frustum bounds are never pushed into the projection
		 * matrix, so a resize re-stretched the canvas while the camera carried on
		 * projecting at the old aspect ratio.
		 */
		camera.updateProjectionMatrix();

		// Reset renderer
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		renderer.setSize(window.innerWidth, window.innerHeight);
		renderer.render(scene, camera);
	}

	document.addEventListener('astro:page-load', () => {
		let controller: AbortController | null;

		updateState(GAME_STATES.LOADING);

		pageContainerElement = document.getElementById('container');
		scoreElement = document.getElementById('score-value');
		finalScoreElement = document.getElementById('final-score');
		if (scoreElement && pageContainerElement) {
			init();
		}

		const startButton = document.getElementById('start-button');
		if (startButton) {
			controller = new AbortController();
			const { signal } = controller;

			startButton?.addEventListener('click', startGame, { signal });
			document.addEventListener('touchstart', splitBlockAndAddNextOneIfOverlaps, { signal });
			document.addEventListener('keydown', handleOnKeydown, { signal });
			window.addEventListener('resize', handleOnResize, { signal });
		}

		document.addEventListener('astro:before-preparation', () => {
			if (controller) {
				controller.abort();
			}

			// Clean up Three.js resources to prevent memory leaks
			if (renderer) {
				renderer.setAnimationLoop(null);
				renderer.dispose();
			}

			if (scene) {
				// Dispose of all meshes in the scene
				for (const child of scene.children) {
					if (child instanceof THREE.Mesh) {
						if (child.geometry) {
							child.geometry.dispose();
						}
						if (child.material) {
							if (Array.isArray(child.material)) {
								for (const material of child.material) {
									material.dispose();
								}
							} else {
								child.material.dispose();
							}
						}
					}
				}
				// Clear the scene
				scene.clear();
			}

			// Clean up Cannon.js world
			if (world) {
				while (world.bodies.length > 0) {
					world.remove(world.bodies[0]);
				}
			}
		});
	});
</script>

<style>
	@reference "../styles/base.css";

	/* ============================================================
	 * Tower Blocks — the same materials as every other page.
	 * Canvas Black ground, off-white and mint plates, one display
	 * numeral. The beige-and-orange CodePen skin is gone.
	 * ============================================================ */

	#container {
		--game-gutter: clamp(1.25rem, 3vw, 3rem);
		--ink-canvas: oklch(91% 0 0deg);
		--ink-primary: oklch(25% 0.08 160deg);
		--ink-slate: oklch(36% 0.03 262.99deg);
		--mint: oklch(77% 0.17 159.37deg);
		--plate-radius: 24px;

		/*
		 * Fixed rather than `h-full`: `<main>` has no height of its own, so a
		 * percentage height collapsed to zero and every absolutely-positioned
		 * piece of chrome resolved against the viewport instead of the board.
		 * The game is a full-viewport surface; say so.
		 */
		position: fixed;
		inset: 0;
		background: #000;
	}

	#container #game {
		@apply absolute inset-0 z-0;

		/*
		 * Suppresses the double-tap-to-zoom delay on the play surface without
		 * taking pinch-zoom away from the whole page.
		 */
		touch-action: manipulation;
	}

	.visually-hidden {
		position: absolute;
		overflow: hidden;
		clip-path: inset(50%);
		width: 1px;
		height: 1px;
		white-space: nowrap;
	}

	/* ---- Top chrome: the way out, and the running score ---- */

	.chrome-top {
		position: absolute;
		top: var(--game-gutter);
		right: var(--game-gutter);
		left: var(--game-gutter);
		z-index: 10;
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		align-items: baseline;
		pointer-events: none;
	}

	.chrome-top :global(a) {
		pointer-events: auto;
	}

	/* Same dark chip as the instruction label, for the same reason: the tower
	   climbs into this corner and the numeral has to stay readable on a slab. */
	#container #score {
		margin: 0;
		padding: 0.25rem 0.75rem 0.4rem;
		border-radius: 16px;
		background: color-mix(in oklch, #000 82%, transparent);
		color: var(--ink-canvas);
		font-weight: 700;
		font-size: clamp(3rem, 9vw, 8rem);
		font-family: var(--font-sans-serif);
		line-height: 0.8;
		letter-spacing: -0.03em;
		opacity: 0%;
		transition: opacity 0.4s ease;
		font-variant-numeric: tabular-nums;
	}

	#container.playing #score,
	#container.resetting #score,
	#container.ended #score {
		opacity: 100%;
	}

	/* ---- Plates: bottom-left, clear of the tower ----
	 *
	 * The ready and game-over panels used to be centred in a `justify-around`
	 * column, which printed the title and the Start button straight across the
	 * face of the stack. They share one slot in the lower-left corner now, so
	 * the tower always has the middle of the frame to itself.
	 */

	.plate-slot {
		position: absolute;
		bottom: var(--game-gutter);
		left: var(--game-gutter);
		z-index: 10;
		display: grid;

		/* Both plates share one grid cell so they occupy the same corner. Without
		   `end` the shorter one stretches to the taller one's height and the
		   game-over plate rendered with a dead band under its last line. */
		align-items: end;
		width: min(34rem, calc(100% - (2 * var(--game-gutter))));
	}

	.plate {
		display: flex;
		flex-direction: column;
		grid-area: 1 / 1;
		gap: clamp(0.75rem, 1.5vw, 1rem);
		align-items: start;
		padding: clamp(1.75rem, 3vw, 2.5rem);
		border-radius: var(--plate-radius);
		opacity: 0%;
		pointer-events: none;
		transition: opacity 0.5s ease;
		transform: translateY(16px);
	}

	.plate-canvas {
		background: var(--ink-canvas);
		color: #000;
	}

	.plate-mint {
		background: var(--mint);
		color: var(--ink-primary);
	}

	.plate-label {
		margin: 0;
		color: var(--ink-slate);
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.plate-mint .plate-label {
		color: var(--ink-primary);
	}

	#container .game-ready h1,
	#container .game-over h2 {
		margin: 0;
		color: inherit;
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3.25rem);
		font-family: var(--font-sans-serif);
		line-height: 0.95;
		letter-spacing: -0.015em;
		text-transform: uppercase;
	}

	.plate-body {
		max-width: 44ch;
		margin: 0;
		color: var(--ink-slate);
		font-weight: 500;
		font-size: clamp(0.95rem, 1.2vw, 1.075rem);
		font-family: var(--font-sans);
		line-height: 1.55;
	}

	.plate-mint .plate-body {
		color: var(--ink-primary);
	}

	/* Filled mint pill on the off-white plate — the one primary action
	   on the page, matching the panel-tier CTA elsewhere on the site. */
	.plate-action {
		margin-top: 0.5rem;
		padding: 0.75rem 1.5rem;
		border: none;
		border-radius: 9999px;
		background: var(--mint);
		color: var(--ink-primary);
		font-weight: 600;
		font-size: var(--text-base);
		font-family: var(--font-sans);
		cursor: pointer;
		transition: background-color 0.3s cubic-bezier(0.32, 0.72, 0, 1);
	}

	.plate-action:hover,
