---
import BaseLayout from '@/layouts/base.astro';
import '@/styles/404.css';

const meta = {
	title: 'Page not found — Curtis Blanton',
	description: 'That page does not exist. Here is the way back.',
};

/**
 * The marquee band is a real, repeated string rather than a CSS `content` trick
 * so it survives with motion disabled — it simply stops moving and reads as a
 * printed rule across the foot of the page.
 */
const MARQUEE_WORD = 'Page not found';
const MARQUEE_REPEATS = 8;
const marquee = Array.from({ length: MARQUEE_REPEATS }, () => MARQUEE_WORD);
---

<BaseLayout meta={meta}>
	{
		/* A `div`, not a `main`: BaseLayout already provides the page's `<main>`
	     landmark, and nesting a second one inside it is a landmark violation. */
	}
	<div class="not-found">
		<div class="not-found-inner">
			<p class="not-found-status">Error 404</p>

			<h1 class="not-found-code">404</h1>

			<p class="not-found-copy">
				This page does not exist. It may have been renamed, or the link that brought you here was
				wrong.
			</p>

			<div class="not-found-actions">
				<a
					href="/"
					class="not-found-primary"
					data-astro-prefetch
				>
					Back to the portfolio
				</a>

				<a
					href="/#project-cards"
					class="not-found-secondary"
					data-astro-prefetch
				>
					See selected work
				</a>
			</div>
		</div>

		<div
			class="not-found-marquee"
			aria-hidden="true"
		>
			<div class="not-found-marquee-track">
				{
					/* Two identical runs of the same list: the track translates by
				     exactly half its width, so the second run is standing where the
				     first one started when the animation loops and there is no seam. */
					[0, 1].map(() => (
						<ul class="not-found-marquee-run">
							{marquee.map((word) => (
								<li>
									{word}
									<span class="not-found-marquee-tick">·</span>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</div>
</BaseLayout>
