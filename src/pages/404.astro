---
import BaseLayout from '@/layouts/base.astro';
import '@/styles/404.css';

const title = 'Page not found — Curtis Blanton';
const description = 'That page does not exist. Here is the way back.';

/**
 * Deterministic star field. `Math.random()` at build time gave a different
 * layout on every rebuild, which made the page impossible to diff or to pin in
 * a screenshot test. A cheap integer hash off the index gives the same
 * scattered-but-not-gridded result and reproduces exactly.
 */
const STAR_COUNT = 64;
const stars = Array.from({ length: STAR_COUNT }, (_, i) => {
	const hash = (n: number) => (((Math.sin(n) * 43758.5453) % 1) + 1) % 1;
	return {
		top: Math.round(hash(i + 1) * 100),
		left: Math.round(hash(i + 101) * 100),
		size: 1 + Math.round(hash(i + 201) * 2),
		delay: -(i % 8),
	};
});
---

<BaseLayout meta={{ title, description }}>
	<div id="page-wrapper">
		<div
			id="stars"
			aria-hidden="true"
		>
			{
				stars.map((star) => (
					<span
						class="star"
						style={`--star-top: ${star.top}vh; --star-left: ${star.left}vw; --star-size: ${star.size}px; --star-delay: ${star.delay}s;`}
					/>
				))
			}
		</div>

		{
			/* A `div`, not a `main`: BaseLayout already provides the page's `<main>`
		     landmark, and nesting a second one inside it is a landmark violation. */
		}
		<div class="not-found">
			<p class="not-found-status">Error 404</p>

			<h1 class="not-found-code hero-gradient-text-dark">404</h1>

			<p class="not-found-copy">
				This page does not exist. It may have been renamed, or the link that brought you here was
				wrong.
			</p>

			<div class="not-found-actions">
				<a
					href="/"
					class="not-found-primary"
					data-astro-prefetch
				>
					Back to the portfolio
				</a>

				<a
					href="/#project-cards"
					class="not-found-secondary"
					data-astro-prefetch
				>
					See selected work
				</a>
			</div>
		</div>
	</div>
</BaseLayout>
