---
import BaseLayout from '@/layouts/base.astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('project');
	return projects.map((project) => ({
		params: { slug: project.id.replace(/\.md$/, '') },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'project'>;
}

const { project } = Astro.props;
const { data } = project;

const nextEntry = await getEntry('project', data.nextSlug);
const nextSlug = nextEntry ? nextEntry.id.replace(/\.md$/, '') : null;
const nextTitle = nextEntry?.data.title ?? null;

const displayUrl = data.url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const panelHeading = data.linkText === 'View Source' ? 'Read the source.' : 'See it live.';

const problemFirstLine = data.problem.split('\n')[0]?.trim() ?? '';
const meta = {
	title: `${data.title} — Case Study — Curtis Blanton`,
	description:
		problemFirstLine.length > 155 ? `${problemFirstLine.slice(0, 152)}…` : problemFirstLine,
};

const romanNumerals = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
---

<BaseLayout meta={meta}>
	<article
		class="case-study"
		data-variant={data.variant}
	>
		<header class="masthead">
			<a
				href="/"
				class="back-link"
				data-astro-prefetch
			>
				<span
					class="back-link-arrow"
					aria-hidden="true"
					>←</span
				>
				<span class="back-link-label">Back to portfolio</span>
			</a>

			<div class="masthead-inner">
				<div class="masthead-lead">
					<p class="lead">{data.problem}</p>
					<h1 class="title">{data.title}</h1>
				</div>

				<dl class="meta-rail">
					<div class="meta-item">
						<dt>Role</dt>
						<dd>{data.role}</dd>
					</div>
					<div class="meta-item">
						<dt>Timeline</dt>
						<dd>{data.timeline}</dd>
					</div>
					<div class="meta-item">
						<dt>Stack</dt>
						<dd>{data.stack.join(' · ')}</dd>
					</div>
				</dl>
			</div>
		</header>

		<figure class="hero-artifact">
			<Image
				src={data.screenshotImage}
				widths={[720, 1080, 1440, 1920, data.screenshotImage.width]}
				sizes="(min-width: 1200px) 1200px, 100vw"
				alt={`${data.title} — full-page screenshot`}
				class="hero-artifact-image"
				loading="eager"
			/>
			<figcaption class="hero-artifact-caption">
				<span
					aria-hidden="true"
					class="caption-rule"
				></span>
				<span>{data.tags.join(' · ')}</span>
			</figcaption>
		</figure>

		<section
			class="approach"
			aria-label="Design approach"
		>
			{
				data.approach.map((move, index) => (
					<article
						class="move"
						data-index={index}
						data-accent={index === 1 ? 'mint' : 'neutral'}
					>
						<span
							class="folio"
							aria-hidden="true"
						>
							Move&nbsp;{romanNumerals[index] ?? String(index + 1)}
							<span class="folio-total"> / {data.approach.length}</span>
						</span>
						<h2 class="move-title">{move.name}</h2>
						<p class="move-body">{move.body}</p>
					</article>
				))
			}
		</section>

		{
			data.motionMoments.length > 0 && (
				<section
					class="moments"
					aria-label="Motion moments"
				>
					<div class="moments-heading">
						<h2>Motion has a job.</h2>
						<p>
							Every animation in this project earns a place by telling the reader something they'd
							otherwise have to guess at.
						</p>
					</div>

					<div class="moments-grid">
						{data.motionMoments.map((moment) => (
							<article class="moment">
								<span
									class="quote-glyph"
									aria-hidden="true"
								>
									“
								</span>
								<h3 class="moment-title">{moment.name}</h3>
								<p class="moment-body">{moment.description}</p>
							</article>
						))}
					</div>
				</section>
			)
		}

		<section
			class="live-panel"
			aria-label="See the live project"
		>
			<a
				href={data.url}
				target="_blank"
				rel="noopener noreferrer"
				class="live-panel-link"
			>
				<div class="live-panel-lead">
					<h2 class="live-panel-heading">{panelHeading}</h2>
					<span class="live-panel-url">
						<span class="live-panel-url-text">{displayUrl}</span>
					</span>
				</div>
				<span
					class="live-panel-arrow"
					aria-hidden="true"
					>↗</span
				>
			</a>
		</section>

		{
			nextSlug && nextTitle && (
				<aside
					class="next"
					aria-label="Next case study"
				>
					<a
						href={`/work/${nextSlug}`}
						class="next-link"
						data-astro-prefetch
					>
						<span class="next-label">Next case study</span>
						<span class="next-title">{nextTitle}</span>
						<span
							class="next-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>
				</aside>
			)
		}
	</article>
</BaseLayout>

<style>
	@reference "../../styles/base.css";

	/* ============================================================
	 * Case study — a Kinetic Monograph plate.
	 * Black canvas gallery wall, Signal Mint drenched endpoints,
	 * off-white plates carry the reading. No shadows, no gradients,
	 * no decorative motion.
	 * ============================================================ */

	.case-study {
		--case-gutter: clamp(1.25rem, 3vw, 3rem);
		--case-plate-radius: 24px;
		--ink-primary: oklch(25% 0.08 160deg); /* primary-ink on mint */
		--ink-canvas: oklch(91% 0 0deg); /* off-white on canvas */
		--ink-slate: oklch(36% 0.03 262.99deg);
		--mint: oklch(77% 0.17 159.37deg);
		--mint-deep: oklch(48% 0.13 159.37deg);

		position: relative;
		display: flex;
		flex-direction: column;
		gap: clamp(4rem, 8vw, 8rem);
		background: #000;
		color: var(--ink-canvas);
	}

	/* ---- Back link (tertiary tier) ----
	 *
	 * Lives inside the masthead, not the black canvas above it: `--ink-primary`
	 * is the on-mint ink and measured 1.38:1 when the link sat on `#000`.
	 */

	.back-link {
		position: absolute;
		top: clamp(1rem, 3vw, 2rem);
		left: var(--case-gutter);
		z-index: 5;
		display: inline-flex;
		gap: 0.6rem;
		align-items: center;
		color: var(--ink-primary);
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.back-link-arrow {
		display: inline-block;
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.back-link:hover .back-link-arrow,
	.back-link:focus-visible .back-link-arrow {
		transform: translateX(-3px);
	}

	.back-link-label {
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
		transition: border-color 0.25s ease-out;
	}

	.back-link:hover .back-link-label,
	.back-link:focus-visible .back-link-label {
		border-bottom-color: currentColor;
	}

	@media (prefers-reduced-motion: reduce) {
		.back-link-arrow,
		.back-link-label {
			transition: none;
		}
	}

	/* ============================================================
	 * MASTHEAD — drenched Signal Mint. First fold.
	 * ============================================================ */

	.masthead {
		position: relative;
		display: grid;
		align-content: center;
		min-height: min(100dvh, 900px);
		padding: clamp(6rem, 12vw, 10rem) var(--case-gutter) clamp(3rem, 6vw, 5rem);
		background: var(--mint);
		color: var(--ink-primary);
	}

	.masthead-inner {
		display: grid;
		grid-template-rows: auto;
		grid-template-columns: minmax(0, 1fr) minmax(200px, 22ch);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: end;
		width: 100%;
		max-width: 1400px;
		margin-inline: auto;
	}

	.masthead-lead {
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, 3vw, 3rem);
		min-width: 0;
	}

	.lead {
		max-width: 42ch;
		margin: 0;
		color: var(--ink-primary);
		font-weight: 500;
		font-size: clamp(1.1rem, 1.6vw, 1.55rem);
		font-family: var(--font-sans);
		line-height: 1.5;
		text-wrap: pretty;
	}

	.title {
		margin: 0;
		color: var(--ink-primary);
		font-weight: 800;
		font-size: clamp(3.5rem, 13vw, 14rem);
		font-family: var(--font-sans-serif);
		line-height: 0.85;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	/* Meta rail — editorial colophon on the right column at desktop,
	   collapses to a horizontal rail beneath the title on narrow viewports. */
	.meta-rail {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1.25rem, 2vw, 1.75rem);
		align-self: end;
		margin: 0;
		padding: clamp(1rem, 2vw, 1.5rem) 0 0.25rem clamp(1.25rem, 2vw, 2rem);
		border-left: 1px solid color-mix(in oklch, var(--ink-primary) 40%, transparent);
	}

	.meta-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 8ch;
	}

	@media (width <= 780px) {
		.masthead-inner {
			grid-template-columns: 1fr;
			gap: clamp(2rem, 6vw, 3rem);
			align-items: start;
		}

		.meta-rail {
			grid-template-columns: repeat(auto-fit, minmax(8ch, max-content));
			gap: clamp(1.5rem, 4vw, 3rem);
			align-self: stretch;
			padding: clamp(1rem, 2vw, 1.5rem) 0 0;
			border-top: 1px solid color-mix(in oklch, var(--ink-primary) 40%, transparent);
			border-left: none;
		}
	}

	/*
	 * Label hierarchy comes from case, weight and tracking, not from a lighter
	 * ink. On the mint plate at this size there is no value both light enough
	 * to read as secondary and dark enough to clear 4.5:1, so the type
	 * treatment carries it and the color stays at full strength.
	 */
	.meta-item dt {
		color: var(--ink-primary);
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.meta-item dd {
		margin: 0;
		color: var(--ink-primary);
		font-weight: 500;
		font-size: clamp(1rem, 1.2vw, 1.15rem);
		font-family: var(--font-sans);
		line-height: 1.4;
	}

	/* ============================================================
	 * HERO ARTIFACT — canvas-black, framed screenshot.
	 * ============================================================ */

	.hero-artifact {
		display: flex;
		flex-direction: column;
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
		align-items: center;
		margin: 0;
		padding: 0 var(--case-gutter);
	}

	.hero-artifact-image {
		display: block;
		object-fit: cover;
		object-position: top center;
		width: 100%;
		max-width: 1200px;
		height: auto;
		max-height: min(85vh, 780px);
		border-radius: var(--case-plate-radius);
		background: var(--ink-canvas);
	}

	.hero-artifact-caption {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
		max-width: 1200px;
		margin: 0;
		padding: 0 0.5rem;
		color: color-mix(in oklch, var(--ink-canvas) 65%, transparent);
		font-weight: 500;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.caption-rule {
		display: inline-block;
		flex: 0 0 auto;
		width: 24px;
		height: 1px;
		background: color-mix(in oklch, var(--ink-canvas) 40%, transparent);
	}

	/* ============================================================
	 * APPROACH SPINE — one editorial move per slab.
	 * Roman-numeral folio marks (book-plate device, NOT eyebrows).
	 * Alternating plates: neutral off-white, mint accent on index 1.
	 * ============================================================ */

	.approach {
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		padding: 0 var(--case-gutter);
	}

	.move {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1.25rem, 2vw, 2rem);
		width: 100%;
		max-width: 1200px;
		margin-inline: auto;
		padding: clamp(2rem, 4vw, 4rem) clamp(1.5rem, 3vw, 3rem);
		border-radius: var(--case-plate-radius);
		background: var(--ink-canvas);
		color: #000;
	}

	.move[data-accent='mint'] {
		background: var(--mint);
		color: var(--ink-primary);
	}

	/* Asymmetry: index 0 leans left, index 1 (mint accent) sits wider and
	   centered as the emphasis, index 2 leans right. Narrower plates on the
	   flanks give the mint plate compositional weight. Deliberate, not
	   decorative. */
	.move[data-index='0'] {
		max-width: 880px;
		margin-right: auto;
		margin-left: 0;
	}

	.move[data-index='2'] {
		max-width: 880px;
		margin-right: 0;
		margin-left: auto;
	}

	@media (width <= 900px) {
		.move[data-index='0'],
		.move[data-index='2'] {
			max-width: 100%;
			margin-inline: auto;
		}
	}

	.folio {
		position: absolute;
		top: clamp(1rem, 2vw, 1.5rem);
		right: clamp(1.5rem, 3vw, 3rem);

		/* Inherits the plate's own ink — see `.meta-item dt`. */
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}

	/*
	 * The " / 3" reads as secondary through its position and the surrounding
	 * type, not through a dimmed opacity: at 55% it measured 4.45:1 on the
	 * off-white plate, just under the 4.5:1 floor.
	 */
	.folio-total {
		opacity: 80%;
	}

	.move-title {
		margin: 0;
		color: inherit;
		font-weight: 800;
		font-size: clamp(2rem, 4vw, 3.5rem);
		font-family: var(--font-sans-serif);
		line-height: 0.95;
		letter-spacing: -0.015em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.move-body {
		max-width: 68ch;
		margin: 0;
		color: inherit;
		font-weight: 500;
		font-size: clamp(1.05rem, 1.3vw, 1.2rem);
		font-family: var(--font-sans);
		line-height: 1.55;
		text-wrap: pretty;
	}

	/* ============================================================
	 * MOTION MOMENTS — editorial pull-quote treatment on canvas.
	 * ============================================================ */

	.moments {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 4vw, 3.5rem);
		padding: clamp(2rem, 5vw, 4rem) var(--case-gutter);
	}

	.moments-heading {
		width: 100%;
		max-width: 1200px;
		margin-inline: auto;
	}

	.moments-heading h2 {
		margin: 0 0 0.5rem;
		color: var(--ink-canvas);
		font-weight: 800;
		font-size: clamp(2.25rem, 5vw, 4rem);
		font-family: var(--font-sans-serif);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.moments-heading p {
		max-width: 60ch;
		margin: 0;
		color: color-mix(in oklch, var(--ink-canvas) 70%, transparent);
		font-weight: 500;
		font-size: clamp(1rem, 1.3vw, 1.15rem);
		font-family: var(--font-sans);
		line-height: 1.5;
	}

	.moments-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: clamp(1rem, 2vw, 1.75rem);
		width: 100%;
		max-width: 1200px;
		margin-inline: auto;
	}

	.moment {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: clamp(0.75rem, 1.5vw, 1rem);
		padding: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 2.5vw, 2.5rem) clamp(1.75rem, 3vw, 2.5rem);
		border-radius: var(--case-plate-radius);
		background: var(--ink-canvas);
		color: #000;
	}

	.quote-glyph {
		position: absolute;
		top: clamp(-0.5rem, -1vw, -0.25rem);
		left: clamp(0.75rem, 2vw, 1.5rem);
		color: var(--mint-deep);
		font-weight: 800;
		font-size: clamp(5rem, 8vw, 7rem);
		font-family: var(--font-sans-serif);
		line-height: 1;
		pointer-events: none;
		user-select: none;
	}

	.moment-title {
		position: relative;
		margin: 0;
		color: #000;
		font-weight: 700;
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		font-family: var(--font-sans-serif);
		line-height: 1;
		letter-spacing: -0.01em;
		text-transform: uppercase;
	}

	.moment-body {
		margin: 0;
		color: var(--ink-slate);
		font-weight: 500;
		font-size: clamp(0.95rem, 1.2vw, 1.075rem);
		font-family: var(--font-sans);
		line-height: 1.55;
		text-wrap: pretty;
	}

	/* ============================================================
	 * LIVE PANEL — Signal Mint peak-end. Panel-tier CTA.
	 * ============================================================ */

	.live-panel {
		padding: 0 var(--case-gutter);
	}

	.live-panel-link {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: center;
		overflow: hidden;
		width: 100%;
		max-width: 1200px;
		margin-inline: auto;
		padding: clamp(3rem, 7vw, 6rem) clamp(2rem, 4vw, 4rem);
		border-radius: var(--case-plate-radius);
		background: var(--mint);
		color: var(--ink-primary);
		text-decoration: none;
	}

	.live-panel-lead {
		display: flex;
		flex-direction: column;
		gap: clamp(1rem, 2vw, 1.75rem);
		min-width: 0;
	}

	.live-panel-heading {
		margin: 0;
		color: var(--ink-primary);
		font-weight: 800;
		font-size: clamp(3rem, 8vw, 6rem);
		font-family: var(--font-sans-serif);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.live-panel-url {
		display: inline-flex;
		gap: 0.5rem;
		align-items: baseline;
		color: var(--ink-primary);
		font-weight: 500;
		font-size: clamp(1.1rem, 1.5vw, 1.35rem);
		font-family: var(--font-sans);
	}

	.live-panel-url-text {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
		transition: text-decoration-thickness 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.live-panel-link:hover .live-panel-url-text,
	.live-panel-link:focus-visible .live-panel-url-text {
		text-decoration-thickness: 2px;
	}

	/* Oversized outbound arrow — compositional right-column anchor.
	   The panel becomes a departure gesture, not a lopsided text block. */
	.live-panel-arrow {
		display: block;
		color: var(--ink-primary);
		font-weight: 800;
		font-size: clamp(6rem, 14vw, 14rem);
		font-family: var(--font-sans-serif);
		line-height: 0.85;
		transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
		transform-origin: 60% 40%;
	}

	.live-panel-link:hover .live-panel-arrow,
	.live-panel-link:focus-visible .live-panel-arrow {
		transform: translate(0.5rem, -0.5rem);
	}

	@media (width <= 640px) {
		.live-panel-link {
			grid-template-columns: 1fr;
			gap: clamp(1.5rem, 4vw, 2.5rem);
		}

		.live-panel-arrow {
			font-size: clamp(4rem, 18vw, 7rem);
			line-height: 1;
			text-align: right;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.live-panel-url-text,
		.live-panel-arrow {
			transition: none;
		}
	}

	/* ============================================================
	 * NEXT HANDOFF — small, quiet plate.
	 * ============================================================ */

	.next {
		padding: 0 var(--case-gutter) clamp(3rem, 6vw, 5rem);
	}

	.next-link {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: clamp(1rem, 2vw, 2rem);
		align-items: end;
		width: 100%;
		max-width: 1200px;
		margin-inline: auto;
		padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
		border-radius: var(--case-plate-radius);
		background: var(--ink-canvas);
		color: #000;
		text-decoration: none;
	}

	.next-label {
		grid-column: 1;
		color: var(--ink-slate);
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.next-title {
		grid-row: 2;
		grid-column: 1;
		color: #000;
		font-weight: 800;
		font-size: clamp(1.75rem, 3.5vw, 3rem);
		font-family: var(--font-sans-serif);
		line-height: 0.95;
		letter-spacing: -0.015em;
		text-transform: uppercase;
	}

	.next-arrow {
		grid-row: 1 / span 2;
		grid-column: 2;
		align-self: center;
		color: var(--mint-deep);
		font-weight: 800;
		font-size: clamp(2rem, 4vw, 3rem);
		font-family: var(--font-sans-serif);
		line-height: 1;
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.next-link:hover .next-arrow,
	.next-link:focus-visible .next-arrow {
		transform: translateX(8px);
	}

	@media (prefers-reduced-motion: reduce) {
		.next-arrow {
			transition: none;
		}
	}

	/* ============================================================
	 * Reveal choreography (opt-in via html.has-motion).
	 * Defaults are visible; reveal only hides when JS has confirmed
	 * motion is allowed. This preserves the site's "never a blank
	 * page waiting for a class trigger" contract.
	 * ============================================================ */

	:global(html.has-motion) .lead,
	:global(html.has-motion) .title,
	:global(html.has-motion) .meta-rail,
	:global(html.has-motion) .hero-artifact,
	:global(html.has-motion) .move,
	:global(html.has-motion) .moment,
	:global(html.has-motion) .live-panel-link,
	:global(html.has-motion) .next-link {
		opacity: 0%;
		transition:
			opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
		transform: translateY(24px);
	}

	:global(html.has-motion) .is-visible.lead,
	:global(html.has-motion) .is-visible .lead,
	:global(html.has-motion) .is-visible.title,
	:global(html.has-motion) .is-visible .title,
	:global(html.has-motion) .is-visible.meta-rail,
	:global(html.has-motion) .is-visible .meta-rail,
	:global(html.has-motion) .is-visible.hero-artifact,
	:global(html.has-motion) .is-visible.move,
	:global(html.has-motion) .is-visible.moment,
	:global(html.has-motion) .is-visible.live-panel-link,
	:global(html.has-motion) .is-visible.next-link {
		opacity: 100%;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html.has-motion) .lead,
		:global(html.has-motion) .title,
		:global(html.has-motion) .meta-rail,
		:global(html.has-motion) .hero-artifact,
		:global(html.has-motion) .move,
		:global(html.has-motion) .moment,
		:global(html.has-motion) .live-panel-link,
		:global(html.has-motion) .next-link {
			opacity: 100%;
			transition: none;
			transform: none;
		}
	}
</style>

<script>
	// Slab reveal via IntersectionObserver. Defaults-visible for reduced motion
	// and no-JS handled entirely in CSS; this script only activates the fade-up
	// when motion is safe and JS is available.
	function initReveal() {
		if (!document.documentElement.classList.contains('has-motion')) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const targets = document.querySelectorAll<HTMLElement>(
			[
				'.case-study .lead',
				'.case-study .title',
				'.case-study .meta-rail',
				'.case-study .hero-artifact',
				'.case-study .move',
				'.case-study .moment',
				'.case-study .live-panel-link',
				'.case-study .next-link',
			].join(','),
		);
		if (!targets.length) return;

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
		);

		targets.forEach((el) => observer.observe(el));
	}

	document.addEventListener('astro:page-load', initReveal, { once: false });
</script>
