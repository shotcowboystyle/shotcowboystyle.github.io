---
import BackLink from '@/components/back-link.astro';
import MotionDemo from '@/components/motion-demo.astro';
import BaseLayout from '@/layouts/base.astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('project');
	return projects.map((project) => ({
		params: { slug: project.id.replace(/\.md$/, '') },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<'project'>;
}

const { project } = Astro.props;
const { data } = project;

const nextEntry = await getEntry('project', data.nextSlug);
const nextSlug = nextEntry ? nextEntry.id.replace(/\.md$/, '') : null;
const nextTitle = nextEntry?.data.title ?? null;

const displayUrl = data.url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const panelHeading = data.linkText === 'View Source' ? 'Read the source.' : 'See it live.';

const problemFirstLine = data.problem.split('\n')[0]?.trim() ?? '';
const meta = {
	title: `${data.title} — Case Study — Curtis Blanton`,
	description:
		problemFirstLine.length > 155 ? `${problemFirstLine.slice(0, 152)}…` : problemFirstLine,
	/* A case study is an article, and its share image is its own screenshot
	   rather than the site-wide card. */
	type: 'article' as const,
	image: data.screenshotImage.src,
};
---

<BaseLayout meta={meta}>
	<article
		class="case-study"
		data-variant={data.variant}
	>
		<header class="masthead">
			{
				/* Wrapped rather than styled through a `class` prop: Astro scopes this
			     file's CSS with a `data-astro-cid` attribute that the component's own
			     root element does not carry, so a `.masthead-back` rule here would
			     never match it and the link stayed in the flow. */
			}
			<div class="masthead-back">
				<BackLink tone="ink" />
			</div>

			<div class="masthead-inner">
				<p class="lead">{data.problem}</p>
				<h1 class="title">{data.title}</h1>

				<dl class="meta-rail">
					<div class="meta-item">
						<dt>Role</dt>
						<dd>{data.role}</dd>
					</div>
					<div class="meta-item">
						<dt>Timeline</dt>
						<dd>{data.timeline}</dd>
					</div>
					<div class="meta-item">
						<dt>Stack</dt>
						<dd>{data.stack.join(' · ')}</dd>
					</div>
				</dl>
			</div>

			<p
				class="masthead-cue"
				aria-hidden="true"
			>
				<span class="masthead-cue-label">Scroll</span>
				<span class="masthead-cue-rule"></span>
			</p>
		</header>

		{
			/*
			 * The artifact used to be a single still cropped with `object-fit: cover`
			 * to 85vh, which meant a full-page screenshot showed its own hero band and
			 * nothing else, with no way to see the rest. The frame now travels the
			 * whole capture as the section crosses the viewport — the one piece of
			 * scroll-linked motion on the page, and it exists to show something that
			 * was otherwise unreachable.
			 *
			 * `data-scrub` is set by script. Without it the frame has no fixed height
			 * and the full screenshot simply renders at its natural length, so no-JS
			 * and reduced-motion readers get more of the artefact, not less.
			 */
		}
		<figure class="hero-artifact">
			<div
				class="artifact-frame"
				data-artifact-frame
			>
				<Image
					src={data.screenshotImage}
					widths={[720, 1080, 1440, 1920, data.screenshotImage.width]}
					sizes="(min-width: 1280px) 1200px, 100vw"
					alt={`${data.title} — full-page screenshot`}
					class="artifact-image"
					loading="eager"
				/>
			</div>

			<div
				class="artifact-progress"
				aria-hidden="true"
			>
				<span
					class="artifact-progress-fill"
					data-artifact-progress
				></span>
			</div>

			{
				/* No "full page" note: the captures are not all full-page — some are
			     framed mockups — and the progress rule already shows that there is
			     more of the image than the frame is holding. */
			}
			<figcaption class="artifact-caption">
				<span>{data.tags.join(' · ')}</span>
			</figcaption>
		</figure>

		<section
			class="approach"
			aria-label="Design approach"
		>
			{
				/*
				 * Rhythm comes from the alternating plate widths alone — the folio
				 * marks and the tint on the middle plate are gone, because neither
				 * carried information the reader needed. The alternation is driven by
				 * parity rather than hard-coded indices, so a fourth or fifth move
				 * keeps the cadence instead of falling back to full width.
				 */
			}
			{
				data.approach.map((move, index) => (
					<article
						class="move"
						data-side={index % 2 === 0 ? 'lead' : 'trail'}
					>
						<h2 class="move-title">{move.name}</h2>
						<p class="move-body">{move.body}</p>
					</article>
				))
			}
		</section>

		{
			data.outcome.length > 0 && (
				<section
					class="outcome"
					aria-label="Outcome"
				>
					<dl class="outcome-grid">
						{data.outcome.map((item) => (
							<div class="outcome-item">
								<dt>{item.label}</dt>
								<dd>{item.value}</dd>
							</div>
						))}
					</dl>
				</section>
			)
		}

		{
			data.motionMoments.length > 0 && (
				<section
					class="moments"
					aria-label="Motion moments"
				>
					<div class="moments-heading">
						<h2>Motion has a job.</h2>
						<p>
							Every animation in this project earns a place by telling the reader something they'd
							otherwise have to guess at. The diagrams show the shape of each one.
						</p>
					</div>

					<div class="moments-grid">
						{data.motionMoments.map((moment) => (
							<article class="moment">
								{moment.demo ? (
									<MotionDemo kind={moment.demo} />
								) : (
									<span
										class="quote-glyph"
										aria-hidden="true"
									>
										“
									</span>
								)}
								<h3 class="moment-title">{moment.name}</h3>
								<p class="moment-body">{moment.description}</p>
							</article>
						))}
					</div>
				</section>
			)
		}

		<section
			class="live-panel"
			aria-label="See the live project"
		>
			<a
				href={data.url}
				target="_blank"
				rel="noopener noreferrer"
				class="live-panel-link"
			>
				<div class="live-panel-lead">
					<h2 class="live-panel-heading">{panelHeading}</h2>
					<span class="live-panel-url">
						<span class="live-panel-url-text">{displayUrl}</span>
					</span>
				</div>
				<span
					class="live-panel-arrow"
					aria-hidden="true"
					>↗</span
				>
			</a>
		</section>

		{
			data.credits.length > 0 && (
				<section
					class="credits"
					aria-label="Credits"
				>
					<h2 class="credits-heading">Credits</h2>
					<ul class="credits-list">
						{data.credits.map((credit) => (
							<li>{credit}</li>
						))}
					</ul>
				</section>
			)
		}

		{
			nextSlug && nextTitle && (
				<aside
					class="next"
					aria-label="Next case study"
				>
					<a
						href={`/work/${nextSlug}`}
						class="next-link"
						data-astro-prefetch
					>
						<span class="next-label">Next case study</span>
						<span class="next-title">{nextTitle}</span>
						<span
							class="next-arrow"
							aria-hidden="true"
						>
							→
						</span>
					</a>
				</aside>
			)
		}

		{
			/* A case study used to end on the next-study card, which made every
		     route out of the page a route deeper into it. */
		}
		<footer class="case-foot">
			<p class="case-foot-name">Curtis Blanton</p>
			<nav
				class="case-foot-nav"
				aria-label="Site"
			>
				<a
					href="/#project-cards"
					data-astro-prefetch
					>All work</a
				>
				<a
					href="/#about"
					data-astro-prefetch
					>About &amp; contact</a
				>
			</nav>
		</footer>
	</article>
</BaseLayout>

<style>
	@reference "../../styles/base.css";

	/* ============================================================
	 * Case study — a Kinetic Monograph plate.
	 * Black canvas gallery wall, Signal Mint drenched endpoints,
	 * off-white plates carry the reading. No shadows, no gradients.
	 * ============================================================ */

	.case-study {
		--case-gutter: clamp(1.25rem, 3vw, 3rem);
		--case-plate-radius: 24px;
		--case-measure: 1200px;
		--ink-primary: oklch(25% 0.08 160deg); /* primary-ink on mint */
		--ink-canvas: oklch(91% 0 0deg); /* off-white on canvas */
		--ink-slate: oklch(36% 0.03 262.99deg);
		--mint: oklch(77% 0.17 159.37deg);
		--mint-deep: oklch(48% 0.13 159.37deg);

		position: relative;
		display: flex;
		flex-direction: column;
		gap: clamp(4rem, 8vw, 8rem);
		background: #000;
		color: var(--ink-canvas);
	}

	/* ============================================================
	 * MASTHEAD — drenched Signal Mint. First fold.
	 * ============================================================ */

	.masthead {
		position: relative;
		display: grid;

		/*
		 * Anchored to the foot of the fold, not centred in it. Centring put an
		 * equal band of empty mint above and below the block, which read as a
		 * layout waiting for something rather than a title page. Setting it low
		 * makes the empty field above deliberate, and it guarantees the title
		 * clears the back link at every variant and title length.
		 */
		align-content: end;
		min-height: min(100dvh, 900px);
		padding: clamp(5rem, 9vw, 7rem) var(--case-gutter) clamp(5rem, 8vw, 7rem);
		background: var(--mint);
		color: var(--ink-primary);
	}

	.masthead-back {
		position: absolute;
		top: clamp(1rem, 3vw, 2rem);
		left: var(--case-gutter);
		z-index: 5;
	}

	/*
	 * One grid, three named areas, and the variant decides how they are placed.
	 * `variant` has been in the content schema from the start but nothing ever
	 * read it, so `feature`, `split` and `poster` all rendered identically.
	 */
	.masthead-inner {
		display: grid;
		grid-template-areas:
			'lead meta'
			'title meta';
		grid-template-columns: minmax(0, 1fr) minmax(200px, 22ch);
		gap: clamp(1.5rem, 3vw, 3rem) clamp(2rem, 5vw, 4.5rem);
		align-items: end;
		width: 100%;
		max-width: 1400px;
		margin-inline: auto;
	}

	.lead {
		grid-area: lead;
		align-self: end;
		max-width: 42ch;
		margin: 0;
		color: var(--ink-primary);
		font-weight: 500;
		font-size: clamp(1.1rem, 1.6vw, 1.55rem);
		font-family: var(--font-sans);
		line-height: 1.5;
		text-wrap: pretty;
	}

	/*
	 * Stepped off the type scale rather than set from a viewport clamp. At
	 * `13vw` the longest title ran wider than its own grid column and printed
	 * straight through the meta rail beside it.
	 */
	.title {
		grid-area: title;
		margin: 0;
		color: var(--ink-primary);
		font-weight: 700;
		font-size: var(--text-6xl);
		font-family: var(--font-sans-serif);
		line-height: 0.85;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		text-wrap: balance;
		overflow-wrap: break-word;
	}

	@media (width >= theme(--breakpoint-sm)) {
		.title {
			font-size: var(--text-8xl);
		}
	}

	@media (width >= theme(--breakpoint-xl)) {
		.title {
			font-size: var(--text-9xl);
		}
	}

	/* `split` — the title takes a full-height column of its own and the reading
	   matter stacks beside it. */
	.case-study[data-variant='split'] .masthead-inner {
		grid-template-areas:
			'title lead'
			'title meta';
		grid-template-columns: minmax(0, 1.25fr) minmax(260px, 1fr);
		align-items: start;
	}

	.case-study[data-variant='split'] .lead {
		align-self: start;
	}

	/* `poster` — title first and largest, everything else beneath it. */
	.case-study[data-variant='poster'] .masthead-inner {
		grid-template-areas:
			'title'
			'lead'
			'meta';
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
	}

	.case-study[data-variant='poster'] .lead {
		align-self: start;
	}

	@media (width >= theme(--breakpoint-xl)) {
		.case-study[data-variant='poster'] .title {
			font-size: clamp(var(--text-9xl), 13vw, 14rem);
		}
	}

	/* Meta rail — editorial colophon beside the title at desktop. */
	.meta-rail {
		display: grid;
		grid-area: meta;
		grid-template-columns: 1fr;
		gap: clamp(1.25rem, 2vw, 1.75rem);
		align-self: end;
		margin: 0;
		padding: clamp(1rem, 2vw, 1.5rem) 0 0.25rem clamp(1.25rem, 2vw, 2rem);
		border-left: 1px solid color-mix(in oklch, var(--ink-primary) 40%, transparent);
	}

	.case-study[data-variant='poster'] .meta-rail,
	.case-study[data-variant='split'] .meta-rail {
		align-self: start;
	}

	.meta-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 8ch;
	}

	@media (width <= 780px) {
		/* Every variant collapses to the same single column. There is no room
		   for a composition below this width, only a reading order. */
		.case-study .masthead-inner,
		.case-study[data-variant='split'] .masthead-inner,
		.case-study[data-variant='poster'] .masthead-inner {
			grid-template-areas:
				'lead'
				'title'
				'meta';
			grid-template-columns: 1fr;
			gap: clamp(2rem, 6vw, 3rem);
			align-items: start;
		}

		.meta-rail {
			grid-template-columns: repeat(auto-fit, minmax(8ch, max-content));
			gap: clamp(1.5rem, 4vw, 3rem);
			align-self: stretch;
			padding: clamp(1rem, 2vw, 1.5rem) 0 0;
			border-top: 1px solid color-mix(in oklch, var(--ink-primary) 40%, transparent);
			border-left: none;
		}
	}

	/*
	 * Under 520px the three-column rail crushed `Stack` into a 6ch gutter and
	 * wrapped "WebExtension APIs · Vite" over four lines. Below that width it
	 * becomes a list of rows.
	 */
	@media (width <= 520px) {
		.meta-rail {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.meta-item {
			gap: 0.2rem;
			padding: 0.85rem 0;
			border-bottom: 1px solid color-mix(in oklch, var(--ink-primary) 25%, transparent);
		}

		.meta-item:last-child {
			border-bottom: none;
		}
	}

	/*
	 * Label hierarchy comes from case, weight and tracking, not from a lighter
	 * ink. On the mint plate at this size there is no value both light enough
	 * to read as secondary and dark enough to clear 4.5:1, so the type
	 * treatment carries it and the color stays at full strength.
	 */
	.meta-item dt {
		color: var(--ink-primary);
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.meta-item dd {
		margin: 0;
		color: var(--ink-primary);
		font-weight: 500;
		font-size: clamp(1rem, 1.2vw, 1.15rem);
		font-family: var(--font-sans);
		line-height: 1.4;
	}

	/* Scroll cue — the fold is a full viewport of flat mint and gave no sign
	   there was anything under it. */
	.masthead-cue {
		position: absolute;
		bottom: clamp(1.25rem, 3vw, 2rem);
		left: var(--case-gutter);
		display: flex;
		gap: 0.75rem;
		align-items: center;
		margin: 0;
		color: var(--ink-primary);
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.masthead-cue-rule {
		display: block;
		width: 3rem;
		height: 1px;
		background: var(--ink-primary);
		transform-origin: left center;
	}

	@media (prefers-reduced-motion: no-preference) {
		.masthead-cue-rule {
			animation: cueDraw 2.6s cubic-bezier(0.32, 0.72, 0, 1) infinite;
		}
	}

	@keyframes cueDraw {
		0%,
		100% {
			transform: scaleX(0.35);
		}
		50% {
			transform: scaleX(1);
		}
	}

	/* ============================================================
	 * HERO ARTIFACT — the full capture, traveled on scroll.
	 * ============================================================ */

	.hero-artifact {
		display: flex;
		flex-direction: column;
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
		align-items: center;
		margin: 0;
		padding: 0 var(--case-gutter);
	}

	.artifact-frame {
		overflow: hidden;
		width: 100%;
		max-width: var(--case-measure);
		border-radius: var(--case-plate-radius);
		background: var(--ink-canvas);
	}

	/* Only the scrubbed frame is clipped. Left alone it renders the whole
	   screenshot at its natural length. */
	.artifact-frame[data-scrub='on'] {
		height: min(78vh, 720px);
	}

	.artifact-image {
		display: block;
		width: 100%;
		height: auto;
		will-change: transform;
	}

	.artifact-progress {
		overflow: hidden;
		width: 100%;
		max-width: var(--case-measure);
		height: 2px;
		border-radius: 1px;
		background: color-mix(in oklch, var(--ink-canvas) 18%, transparent);
		opacity: 0%;
	}

	.artifact-frame[data-scrub='on'] ~ .artifact-progress {
		opacity: 100%;
	}

	.artifact-progress-fill {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--mint);
		transform: scaleX(0);
		transform-origin: left center;
	}

	.artifact-caption {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		max-width: var(--case-measure);
		margin: 0;
		padding: 0 0.25rem;
		color: color-mix(in oklch, var(--ink-canvas) 65%, transparent);
		font-weight: 500;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.artifact-caption-note {
		color: var(--mint);
	}

	/* ============================================================
	 * APPROACH SPINE — one editorial move per slab.
	 * ============================================================ */

	.approach {
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		padding: 0 var(--case-gutter);
	}

	.move {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1.25rem, 2vw, 2rem);
		width: 100%;
		max-width: var(--case-measure);
		margin-inline: auto;
		padding: clamp(2rem, 4vw, 4rem) clamp(1.5rem, 3vw, 3rem);
		border-radius: var(--case-plate-radius);
		background: var(--ink-canvas);
		color: #000;
	}

	.move[data-side='lead'] {
		max-width: 880px;
		margin-right: auto;
		margin-left: 0;
	}

	.move[data-side='trail'] {
		max-width: 880px;
		margin-right: 0;
		margin-left: auto;
	}

	@media (width <= 900px) {
		.move[data-side='lead'],
		.move[data-side='trail'] {
			max-width: 100%;
			margin-inline: auto;
		}
	}

	.move-title {
		margin: 0;
		color: inherit;
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3.5rem);
		font-family: var(--font-sans-serif);
		line-height: 0.95;
		letter-spacing: -0.015em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.move-body {
		max-width: 68ch;
		margin: 0;
		color: inherit;
		font-weight: 500;
		font-size: clamp(1.05rem, 1.3vw, 1.2rem);
		font-family: var(--font-sans);
		line-height: 1.55;
		text-wrap: pretty;
	}

	/* ============================================================
	 * OUTCOME — measured results, when there are any.
	 * ============================================================ */

	.outcome {
		padding: 0 var(--case-gutter);
	}

	.outcome-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
		gap: clamp(1rem, 2vw, 1.75rem);
		width: 100%;
		max-width: var(--case-measure);
		margin: 0 auto;
	}

	.outcome-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: clamp(1.5rem, 3vw, 2.25rem);
		border: 1px solid color-mix(in oklch, var(--ink-canvas) 22%, transparent);
		border-radius: var(--case-plate-radius);
	}

	.outcome-item dt {
		color: color-mix(in oklch, var(--ink-canvas) 70%, transparent);
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.outcome-item dd {
		margin: 0;
		color: var(--mint);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3rem);
		font-family: var(--font-sans-serif);
		line-height: 1;
		letter-spacing: -0.02em;
	}

	/* ============================================================
	 * MOTION MOMENTS — each one shows the shape of its movement.
	 * ============================================================ */

	.moments {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 4vw, 3.5rem);
		padding: clamp(2rem, 5vw, 4rem) var(--case-gutter);
	}

	.moments-heading {
		width: 100%;
		max-width: var(--case-measure);
		margin-inline: auto;
	}

	.moments-heading h2 {
		margin: 0 0 0.5rem;
		color: var(--ink-canvas);
		font-weight: 700;
		font-size: clamp(2.25rem, 5vw, 4rem);
		font-family: var(--font-sans-serif);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.moments-heading p {
		max-width: 60ch;
		margin: 0;
		color: color-mix(in oklch, var(--ink-canvas) 70%, transparent);
		font-weight: 500;
		font-size: clamp(1rem, 1.3vw, 1.15rem);
		font-family: var(--font-sans);
		line-height: 1.5;
	}

	.moments-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: clamp(1rem, 2vw, 1.75rem);
		width: 100%;
		max-width: var(--case-measure);
		margin-inline: auto;
	}

	.moment {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: clamp(0.75rem, 1.5vw, 1rem);
		padding: clamp(1.5rem, 2.5vw, 2rem) clamp(1.5rem, 2.5vw, 2.5rem) clamp(1.75rem, 3vw, 2.5rem);
		border-radius: var(--case-plate-radius);
		background: var(--ink-canvas);
		color: #000;
	}

	/* Only cards with no diagram keep the pull-quote glyph, and those need the
	   old top padding back to clear it. */
	.moment:has(.quote-glyph) {
		padding-top: clamp(2.5rem, 4vw, 3.5rem);
	}

	.quote-glyph {
		position: absolute;
		top: clamp(-0.5rem, -1vw, -0.25rem);
		left: clamp(0.75rem, 2vw, 1.5rem);
		color: var(--mint-deep);
		font-weight: 700;
		font-size: clamp(5rem, 8vw, 7rem);
		font-family: var(--font-sans-serif);
