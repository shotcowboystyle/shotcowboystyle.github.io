	/* ============================================================
	 * LIVE PANEL — Signal Mint peak-end. Panel-tier CTA.
	 * ============================================================ */

	.live-panel {
		padding: 0 var(--case-gutter);
	}

	.live-panel-link {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: center;
		overflow: hidden;
		width: 100%;
		max-width: var(--case-measure);
		margin-inline: auto;
		padding: clamp(3rem, 7vw, 6rem) clamp(2rem, 4vw, 4rem);
		border-radius: var(--case-plate-radius);
		background: var(--mint);
		color: var(--ink-primary);
		text-decoration: none;
	}

	.live-panel-lead {
		display: flex;
		flex-direction: column;
		gap: clamp(1rem, 2vw, 1.75rem);
		min-width: 0;
	}

	.live-panel-heading {
		margin: 0;
		color: var(--ink-primary);
		font-weight: 700;
		font-size: clamp(3rem, 8vw, 6rem);
		font-family: var(--font-sans-serif);
		line-height: 0.9;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.live-panel-url {
		display: inline-flex;
		gap: 0.5rem;
		align-items: baseline;
		color: var(--ink-primary);
		font-weight: 500;
		font-size: clamp(1.1rem, 1.5vw, 1.35rem);
		font-family: var(--font-sans);
	}

	.live-panel-url-text {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
		transition: text-decoration-thickness 0.25s cubic-bezier(0.32, 0.72, 0, 1);
	}

	.live-panel-link:hover .live-panel-url-text,
	.live-panel-link:focus-visible .live-panel-url-text {
		text-decoration-thickness: 2px;
	}

	/* Oversized outbound arrow — compositional right-column anchor.
	   The panel becomes a departure gesture, not a lopsided text block. */
	.live-panel-arrow {
		display: block;
		color: var(--ink-primary);
		font-weight: 700;
		font-size: clamp(6rem, 14vw, 14rem);
		font-family: var(--font-sans-serif);
		line-height: 0.85;
		transition: transform 0.55s cubic-bezier(0.32, 0.72, 0, 1);
		transform-origin: 60% 40%;
	}

	.live-panel-link:hover .live-panel-arrow,
	.live-panel-link:focus-visible .live-panel-arrow {
		transform: translate(0.5rem, -0.5rem);
	}

	@media (width <= 640px) {
		.live-panel-link {
			grid-template-columns: 1fr;
			gap: clamp(1.5rem, 4vw, 2.5rem);
		}

		.live-panel-arrow {
			font-size: clamp(4rem, 18vw, 7rem);
			line-height: 1;
			text-align: right;
		}
	}

	/* ============================================================
	 * CREDITS — rendered only when the entry carries any.
	 * ============================================================ */

	.credits {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(1rem, 3vw, 3rem);
		width: 100%;
		max-width: var(--case-measure);
		margin-inline: auto;
		padding: 0 var(--case-gutter);
	}

	.credits-heading {
		margin: 0;
		color: color-mix(in oklch, var(--ink-canvas) 70%, transparent);
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.credits-list {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--ink-canvas);
		font-weight: 500;
		font-size: clamp(1rem, 1.2vw, 1.1rem);
		font-family: var(--font-sans);
	}

	/* ============================================================
	 * NEXT HANDOFF — small, quiet plate.
	 * ============================================================ */

	.next {
		padding: 0 var(--case-gutter);
	}

	.next-link {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: clamp(1rem, 2vw, 2rem);
		align-items: end;
		width: 100%;
		max-width: var(--case-measure);
		margin-inline: auto;
		padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
		border-radius: var(--case-plate-radius);
		background: var(--ink-canvas);
		color: #000;
		text-decoration: none;
	}

	.next-label {
		grid-column: 1;
		color: var(--ink-slate);
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.next-title {
		grid-row: 2;
		grid-column: 1;
		color: #000;
		font-weight: 700;
		font-size: clamp(1.75rem, 3.5vw, 3rem);
		font-family: var(--font-sans-serif);
		line-height: 0.95;
		letter-spacing: -0.015em;
		text-transform: uppercase;
	}

	.next-arrow {
		grid-row: 1 / span 2;
		grid-column: 2;
		align-self: center;
		color: var(--mint-deep);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 3rem);
		font-family: var(--font-sans-serif);
		line-height: 1;
		transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
	}

	.next-link:hover .next-arrow,
	.next-link:focus-visible .next-arrow {
		transform: translateX(8px);
	}

	/* ============================================================
	 * FOOT — a route out of the case study, not deeper into it.
	 * ============================================================ */

	.case-foot {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		justify-content: space-between;
		align-items: baseline;
		width: 100%;
		max-width: var(--case-measure);
		margin-inline: auto;
		padding: clamp(1.5rem, 3vw, 2rem) var(--case-gutter) clamp(3rem, 6vw, 5rem);
		border-top: 1px solid color-mix(in oklch, var(--ink-canvas) 18%, transparent);
	}

	.case-foot-name,
	.case-foot-nav {
		margin: 0;
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.case-foot-name {
		color: color-mix(in oklch, var(--ink-canvas) 70%, transparent);
	}

	.case-foot-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.case-foot-nav a {
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
		color: var(--ink-canvas);
		text-decoration: none;
		transition: border-color 0.25s ease-out;
	}

	.case-foot-nav a:hover,
	.case-foot-nav a:focus-visible {
		border-bottom-color: currentColor;
	}

	/* ============================================================
	 * Reveal choreography (opt-in via html.has-motion).
	 * Defaults are visible; reveal only hides when JS has confirmed
	 * motion is allowed. This preserves the site's "never a blank
	 * page waiting for a class trigger" contract.
	 *
	 * Each group staggers and each element travels a direction that
	 * matches where it sits: the plates come in from the edge they
	 * are anchored to.
	 *
	 * The masthead is deliberately not in the set. It is the first
	 * fold and the LCP element, so it has no business waiting on an
	 * IntersectionObserver — and while it faded, its ink and the mint
	 * behind it blended to a 1.2:1 pair that an axe scan landing
	 * mid-transition reported as a real contrast failure.
	 * ============================================================ */

	:global(html.has-motion) .case-study :is(.move, .moment, .hero-artifact),
	:global(html.has-motion) .case-study :is(.live-panel-link, .next-link),
	:global(html.has-motion) .case-study :is(.outcome-item, .case-foot) {
		opacity: 0%;
		transition:
			opacity 700ms cubic-bezier(0.32, 0.72, 0, 1) var(--reveal-delay, 0ms),
			transform 700ms cubic-bezier(0.32, 0.72, 0, 1) var(--reveal-delay, 0ms);
		transform: translateY(24px);
	}

	/* Direction, not just distance. */
	:global(html.has-motion) .case-study .move[data-side='lead'] {
		transform: translate3d(-28px, 20px, 0);
	}

	:global(html.has-motion) .case-study .move[data-side='trail'] {
		transform: translate3d(28px, 20px, 0);
	}

	/* Stagger inside each group. */
	:global(html.has-motion) .case-study .moment:nth-child(2),
	:global(html.has-motion) .case-study .outcome-item:nth-child(2) {
		--reveal-delay: 90ms;
	}

	:global(html.has-motion) .case-study .moment:nth-child(3),
	:global(html.has-motion) .case-study .outcome-item:nth-child(3) {
		--reveal-delay: 180ms;
	}

	:global(html.has-motion) .case-study .moment:nth-child(n + 4),
	:global(html.has-motion) .case-study .outcome-item:nth-child(n + 4) {
		--reveal-delay: 270ms;
	}

	/*
	 * Scoped, not `:global(.is-visible)`. Astro appends its `data-astro-cid`
	 * attribute to every non-global compound, so a global `.is-visible` scored
	 * one attribute selector lower than the rule hiding these elements and lost
	 * — revealed content stayed at `opacity: 0` after the observer had fired.
	 */
	:global(html.has-motion) .case-study .is-visible {
		opacity: 100%;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html.has-motion) .case-study :is(.move, .moment, .hero-artifact),
		:global(html.has-motion) .case-study :is(.live-panel-link, .next-link),
		:global(html.has-motion) .case-study :is(.outcome-item, .case-foot) {
			opacity: 100%;
			transition: none;
			transform: none;
		}

		.next-arrow,
		.live-panel-url-text,
		.live-panel-arrow,
		.case-foot-nav a {
			transition: none;
		}
	}
</style>

<script>
	const REVEAL_SELECTOR = [
		'.case-study .hero-artifact',
		'.case-study .move',
		'.case-study .moment',
		'.case-study .outcome-item',
		'.case-study .live-panel-link',
		'.case-study .next-link',
		'.case-study .case-foot',
	].join(',');

	let observer: IntersectionObserver | null = null;
	let detachScrub: (() => void) | null = null;

	function motionAllowed() {
		return (
			document.documentElement.classList.contains('has-motion') &&
			!window.matchMedia('(prefers-reduced-motion: reduce)').matches
		);
	}

	/**
	 * Slab reveal. Defaults-visible for reduced motion and no-JS is handled
	 * entirely in CSS; this only activates the fade-up when motion is safe.
	 */
	function initReveal() {
		if (!motionAllowed()) return;

		const targets = document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR);
		if (!targets.length) return;

		observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer?.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
		);

		targets.forEach((el) => observer?.observe(el));
	}

	/**
	 * Travels the full screenshot through a fixed frame as the figure crosses
	 * the viewport, so the reader sees the whole page rather than the top 780px
	 * of it. Skipped entirely without motion, in which case the frame keeps its
	 * natural height and the image is simply shown in full.
	 */
	function initArtifactScrub() {
		if (!motionAllowed()) return;

		const frame = document.querySelector<HTMLElement>('[data-artifact-frame]');
		const image = frame?.querySelector<HTMLImageElement>('img');
		const progress = document.querySelector<HTMLElement>('[data-artifact-progress]');
		if (!frame || !image) return;

		frame.dataset.scrub = 'on';

		let queued = false;

		const draw = () => {
			queued = false;

			const rect = frame.getBoundingClientRect();
			const travel = rect.height + window.innerHeight;
			const raw = (window.innerHeight - rect.top) / travel;
			const ratio = Math.min(Math.max(raw, 0), 1);

			// Negative: how far the image has to rise to show its own last row.
			const shift = frame.clientHeight - image.offsetHeight;

			image.style.transform = `translate3d(0, ${(ratio * shift).toFixed(2)}px, 0)`;
			if (progress) {
				progress.style.transform = `scaleX(${ratio.toFixed(4)})`;
			}
		};

		const schedule = () => {
			if (queued) return;
			queued = true;
			window.requestAnimationFrame(draw);
		};

		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		// The natural height is only known once the image has decoded.
		image.addEventListener('load', schedule);

		detachScrub = () => {
			window.removeEventListener('scroll', schedule);
			window.removeEventListener('resize', schedule);
			image.removeEventListener('load', schedule);
			frame.removeAttribute('data-scrub');
			image.style.transform = '';
		};

		schedule();
	}

	function teardown() {
		observer?.disconnect();
		observer = null;
		detachScrub?.();
		detachScrub = null;
	}

	document.addEventListener('astro:page-load', () => {
		teardown();
		initReveal();
		initArtifactScrub();
	});

	// View transitions swap the document without a full navigation, so the
	// listeners bound above have to come off before the next page binds its own.
	document.addEventListener('astro:before-swap', teardown);
</script>
