---
import { CONTACT_EMAIL, CONTACT_MAILTO_HREF } from '@/utils/email.server';
---

<a
	href={CONTACT_MAILTO_HREF}
	class="js-inject-email-link contact-button group pointer-events-auto relative flex h-full flex-col justify-between overflow-hidden p-8 no-underline sm:p-10 lg:p-12"
	id="contact-button"
>
	<div
		id="contact-button-animation"
		class="js-lottie-animation relative z-10 mt-0 -ml-6 w-[110%] max-sm:mb-8 sm:-ml-10"
		data-animation-name="contact-button-animation"
		data-animation-source="/animation/lottie-contact-button-animation.json"
		data-animation-play-control="hover"
		data-animation-target="1"
		data-animation-initial-state="99"
		aria-hidden="true"
	></div>

	<div class="relative z-10">
		<h3 class="contact-button-title mb-6 leading-[0.9] font-bold uppercase">
			Let’s build
			<br />
			something.
		</h3>
		<p
			id="email-text"
			class="js-inject-email-text contact-button-email mb-0 font-sans !leading-tight font-medium"
		>
			{CONTACT_EMAIL}
		</p>
	</div>
</a>

<style>
	@reference "../styles/base.css";

	/*
	 * No `color` here on purpose — the card inherits it from the grid cell in
	 * about.astro. Hard-coding `--color-primary-content` was correct while that
	 * cell was `bg-primary`; once it became `!bg-info` the dark green stayed put
	 * and rendered at 1.83:1 on the blue.
	 */

	/*
	 * Sized to the card, not the viewport: the cell is half the screen at sm and
	 * a quarter of it from xl, and viewport steps clipped "SOMETHING." and
	 * the address at the narrow end of each range.
	 */
	#contact-button {
		container-type: inline-size;
	}

	.contact-button-title {
		font-size: clamp(1.5rem, 15cqi, 4.5rem);
	}

	.contact-button-email {
		font-size: clamp(0.875rem, 7.5cqi, 1.25rem);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		overflow-wrap: anywhere;
	}

	.contact-button-email:hover {
		text-decoration-thickness: 2px;
	}

	@media screen and (orientation: landscape) and (hover: none) {
		#contact-button {
			@apply p-6;
		}
	}
</style>
