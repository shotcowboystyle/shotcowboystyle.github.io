---
import CircleButton from '@/components/circle-button.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'project'>;
}

const { id, data } = Astro.props.project;
const variant = data.variant;

const tagList = data.tags;

/*
 * The card opens the project's folio, where the gallery, the facts and the link
 * out to the live site (or its repository) live. The click completes the
 * plate-turn: see `src/lib/view-transition.js`.
 */
const FOLIO_HREF = `/work/${id}/`;
const CTA_TEXT = 'View Project';
const CTA_LABEL = `${CTA_TEXT}: ${data.title}`;
---

<div class:list={['project-card-inner', 'plate-turn', `project-card-variant-${variant}`]}>
	{
		variant === 'feature' && (
			<>
				<Image
					src={data.screenshotImage}
					widths={[480, 680, 720, data.screenshotImage.width]}
					alt={`${data.title} screenshot`}
					class="project-screenshot"
				/>

				<div class="card-content feature-content pointer-events-auto relative z-[2] flex items-end justify-between max-sm:flex-col">
					<div class="max-sm:-mb-16">
						<h2
							data-folio-title
							class="c-animated-text js-split-lines js-reveal-on-scroll mb-4 text-4xl sm:text-6xl lg:text-7xl"
						>
							{data.title}
						</h2>

						<ul class="tech-badge col-auto row-auto mb-8 flex flex-wrap justify-start gap-2 max-sm:items-start sm:gap-3">
							{tagList.map((tag: string) => (
								<li class="relative rounded-full border border-current/70 px-3 py-1 text-xs font-medium tracking-wide uppercase">
									{tag}
								</li>
							))}
						</ul>

						<p class="c-animated-text js-split-lines js-reveal-on-scroll !mb-0 max-w-[45ch] max-sm:mr-24">
							{data.description}
						</p>
					</div>

					<CircleButton
						link={FOLIO_HREF}
						label={CTA_LABEL}
						ringPhrase={CTA_TEXT}
					/>

					<a
						href={FOLIO_HREF}
						data-astro-prefetch
						aria-label={CTA_LABEL}
						class="project-card-link group relative flex h-16 w-16 items-center justify-center rounded-full bg-current text-center sm:hidden"
					>
						<span
							class="project-card-button-label"
							aria-hidden="true"
						>
							{CTA_TEXT}
						</span>
					</a>
				</div>
			</>
		)
	}

	{
		variant === 'split' && (
			<>
				<div class="card-content split-content pointer-events-auto relative z-[2] grid h-full grid-rows-[auto_1fr] gap-8 sm:grid-cols-[1fr_1fr] sm:grid-rows-1 sm:gap-12 lg:gap-16">
					<figure class="split-screenshot-frame relative flex items-center justify-center overflow-hidden rounded-xl p-4 sm:rounded-2xl sm:p-6">
						<Image
							src={data.screenshotImage}
							widths={[480, 680, 720, data.screenshotImage.width]}
							alt={`${data.title} screenshot`}
							class="split-screenshot h-full w-full object-contain"
						/>
					</figure>

					<div class="split-body flex flex-col justify-between gap-8 sm:gap-6">
						<div>
							<h2
								data-folio-title
								class="c-animated-text js-split-lines js-reveal-on-scroll mb-4 text-4xl sm:text-5xl lg:text-6xl"
							>
								{data.title}
							</h2>

							<ul class="tech-badge mb-6 flex flex-wrap justify-start gap-2 max-sm:items-start sm:gap-3">
								{tagList.map((tag: string) => (
									<li class="relative rounded-full border border-current/70 px-3 py-1 text-xs font-medium tracking-wide uppercase">
										{tag}
									</li>
								))}
							</ul>

							<p class="c-animated-text js-split-lines js-reveal-on-scroll !mb-0 max-w-[45ch]">
								{data.description}
							</p>
						</div>

						<div class="flex items-end justify-end">
							<CircleButton
								link={FOLIO_HREF}
								label={CTA_LABEL}
								ringPhrase={CTA_TEXT}
							/>

							<a
								href={FOLIO_HREF}
								data-astro-prefetch
								aria-label={CTA_LABEL}
								class="project-card-link group relative flex h-16 w-16 items-center justify-center rounded-full bg-current text-center sm:hidden"
							>
								<span
									class="project-card-button-label"
									aria-hidden="true"
								>
									{CTA_TEXT}
								</span>
							</a>
						</div>
					</div>
				</div>
			</>
		)
	}
</div>

<style>
	@reference "../styles/base.css";

	.project-card-inner {
		@apply relative flex h-full w-full flex-1 flex-col justify-end;
	}

	/*
	 * The plate is edge-to-edge so the artwork can bleed to the rounded corner.
	 * Padding is a property of the copy, not of the card.
	 */
	.card-content {
		@apply p-5 sm:p-12 lg:p-16;
	}

	/*
	 * FEATURE variant — the screenshot is a framed artifact sitting high and
	 * right on the plate, not a background wash. It used to be cropped by the
	 * plate on two edges, which read as an image that had failed to load rather
	 * than as a deliberate crop; it is fully bounded now and the asymmetry comes
	 * from where it sits instead.
	 */
	.project-screenshot {
		@apply pointer-events-none absolute top-8 right-0 z-[1] inline-block w-[130%] max-w-none rounded-xl align-middle max-sm:left-0 sm:top-10 sm:right-auto sm:w-11/12 sm:max-w-full lg:top-12 lg:right-12 lg:w-[58%];

		border: 1px solid color-mix(in oklab, currentColor 15%, transparent);

		@media screen and (orientation: landscape) and (hover: none) {
			@apply top-8 right-8 w-[55%];
		}
	}

	@media screen and (orientation: landscape) and (hover: none) {
		.project-card-link {
			@apply flex;
		}
	}

	.project-card-button-label {
		@apply relative z-10 px-6 text-xs leading-tight text-(--card-ground);

		@media screen and (orientation: landscape) and (hover: none) {
			@apply text-2xl;
		}
	}

	/* SPLIT variant — screenshot framed left, copy right */
	.project-card-variant-split {
		@apply justify-center;
	}

	.split-screenshot-frame {
		max-height: 60vh;
		border: 1px solid color-mix(in oklab, currentColor 15%, transparent);
		background: color-mix(in oklab, currentColor 8%, transparent);
	}

	@media (width >= theme(--breakpoint-sm)) {
		.split-screenshot-frame {
			max-height: none;
		}
	}
</style>
