---
import CircleButton from '@/components/circle-button.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'project'>;
}

const { data, id } = Astro.props.project;
const variant = data.variant;
const slug = id.replace(/\.md$/, '');
const caseStudyHref = `/work/${slug}`;

const tagList = data.tags;

const CTA_TEXT = 'Read the story';
const CTA_LABEL = `${CTA_TEXT}: ${data.title}`;
---

<div class:list={['project-card-inner', 'plate-turn', `project-card-variant-${variant}`]}>
	<span
		class="plate-turn-ghost"
		aria-hidden="true"
		>Read</span
	>

	{
		variant === 'feature' && (
			<>
				<Image
					src={data.screenshotImage}
					widths={[480, 680, 720, data.screenshotImage.width]}
					alt={`${data.title} screenshot`}
					class="project-screenshot"
				/>

				<div class="card-content feature-content pointer-events-auto relative z-[2] flex items-end justify-between text-white max-sm:flex-col">
					<div class="max-sm:-mb-16">
						<h2 class="mb-4 text-4xl sm:text-6xl lg:text-7xl">{data.title}</h2>

						<ul class="tech-badge col-auto row-auto mb-8 flex flex-wrap justify-start gap-2 max-sm:items-start sm:gap-3">
							{tagList.map((tag: string) => (
								<li class="border-base-100/70 relative rounded-full border px-3 py-1 text-xs font-medium tracking-wide uppercase">
									{tag}
								</li>
							))}
						</ul>

						<p class="!mb-0 max-w-[45ch] max-sm:mr-24">{data.description}</p>
					</div>

					<CircleButton
						link={caseStudyHref}
						label={CTA_LABEL}
					/>

					<a
						href={caseStudyHref}
						aria-label={CTA_LABEL}
						class="project-card-link group relative flex h-16 w-16 items-center justify-center rounded-full bg-white text-center sm:hidden"
					>
						<span
							class="project-card-button-label"
							aria-hidden="true"
						>
							{CTA_TEXT}
						</span>
					</a>
				</div>
			</>
		)
	}

	{
		variant === 'split' && (
			<>
				<div class="card-content split-content pointer-events-auto relative z-[2] grid h-full grid-rows-[auto_1fr] gap-8 text-white sm:grid-cols-[1fr_1fr] sm:grid-rows-1 sm:gap-12 lg:gap-16">
					<figure class="split-screenshot-frame relative flex items-center justify-center overflow-hidden rounded-xl p-4 sm:rounded-2xl sm:p-6">
						<Image
							src={data.screenshotImage}
							widths={[480, 680, 720, data.screenshotImage.width]}
							alt={`${data.title} screenshot`}
							class="split-screenshot h-full w-full object-contain"
						/>
					</figure>

					<div class="split-body flex flex-col justify-between gap-8 sm:gap-6">
						<div>
							<h2 class="mb-4 text-4xl sm:text-5xl lg:text-6xl">{data.title}</h2>

							<ul class="tech-badge mb-6 flex flex-wrap justify-start gap-2 max-sm:items-start sm:gap-3">
								{tagList.map((tag: string) => (
									<li class="border-base-100/70 relative rounded-full border px-3 py-1 text-xs font-medium tracking-wide uppercase">
										{tag}
									</li>
								))}
							</ul>

							<p class="!mb-0 max-w-[45ch]">{data.description}</p>
						</div>

						<div class="flex items-end justify-end">
							<CircleButton
								link={caseStudyHref}
								label={CTA_LABEL}
							/>

							<a
								href={caseStudyHref}
								aria-label={CTA_LABEL}
								class="project-card-link group relative flex h-16 w-16 items-center justify-center rounded-full bg-white text-center sm:hidden"
							>
								<span
									class="project-card-button-label"
									aria-hidden="true"
								>
									{CTA_TEXT}
								</span>
							</a>
						</div>
					</div>
				</div>
			</>
		)
	}

	{
		variant === 'poster' && (
			<>
				<Image
					src={data.screenshotImage}
					widths={[720, 1080, 1440, data.screenshotImage.width]}
					alt={`${data.title} screenshot`}
					class="poster-screenshot"
				/>

				<div
					class="poster-scrim"
					aria-hidden="true"
				/>

				<div class="card-content poster-content pointer-events-auto relative z-[2] flex h-full flex-col justify-end text-white">
					<div class="poster-footer flex items-end justify-between gap-6">
						<div class="max-w-[45ch]">
							<h2 class="mb-4 text-4xl sm:text-6xl lg:text-7xl">{data.title}</h2>

							<ul class="tech-badge mb-4 flex flex-wrap justify-start gap-2 max-sm:items-start sm:gap-3">
								{tagList.map((tag: string) => (
									<li class="relative rounded-full border border-white/70 px-3 py-1 text-xs font-medium tracking-wide uppercase">
										{tag}
									</li>
								))}
							</ul>

							<p class="!mb-0">{data.description}</p>
						</div>

						<CircleButton
							link={caseStudyHref}
							label={CTA_LABEL}
						/>

						<a
							href={caseStudyHref}
							aria-label={CTA_LABEL}
							class="project-card-link group relative flex h-16 w-16 items-center justify-center rounded-full bg-white text-center sm:hidden"
						>
							<span
								class="project-card-button-label"
								aria-hidden="true"
							>
								{CTA_TEXT}
							</span>
						</a>
					</div>
				</div>
			</>
		)
	}
</div>

<style>
	@reference "../styles/base.css";

	.project-card-inner {
		@apply relative flex h-full w-full flex-1 flex-col justify-end;
	}

	/*
	 * The plate is edge-to-edge so the artwork can bleed to the rounded corner.
	 * Padding is a property of the copy, not of the card.
	 */
	.card-content {
		@apply p-5 sm:p-12 lg:p-16;
	}

	/* ============================================================
	 * PLATE-TURN — the project-card hover signature.
	 * The plate tips as though a page were being lifted, and an
	 * oversized ghost "Read" surfaces from underneath it. The mint
	 * specular sweep this used to carry was a linear-gradient
	 * overlay; surfaces are flat now, so the gesture is transform
	 * and type only.
	 * ============================================================ */

	.project-card-inner.plate-turn {
		will-change: transform;
		transition: transform 700ms cubic-bezier(0.32, 0.72, 0, 1);
		transform-origin: right center;
		perspective: 1500px;
		transform-style: preserve-3d;
	}

	.project-card-inner.plate-turn:hover,
	.project-card-inner.plate-turn:focus-within {
		transform: rotate3d(0, 1, 0.05, -2.4deg);
	}

	.plate-turn-ghost {
		position: absolute;
		top: clamp(0.5rem, 2vw, 2rem);
		left: clamp(-1rem, -1vw, 0.5rem);
		z-index: 1;
		max-width: 55%;
		margin: 0;
		color: rgb(255 255 255);
		font-weight: 700;
		font-size: clamp(6rem, 15vw, 14rem);
		font-family: var(--font-sans);
		line-height: 0.85;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		opacity: 0%;
		mix-blend-mode: soft-light;
		pointer-events: none;
		user-select: none;
		transition:
			opacity 700ms cubic-bezier(0.32, 0.72, 0, 1),
			transform 700ms cubic-bezier(0.32, 0.72, 0, 1);
		transform: translateY(12px);
	}

	.project-card-inner.plate-turn:hover .plate-turn-ghost,
	.project-card-inner.plate-turn:focus-within .plate-turn-ghost {
		opacity: 85%;
		transform: translateY(0);
	}

	/* Reduced-motion path: crossfade the ghost only. No rotation. */
	@media (prefers-reduced-motion: reduce) {
		.project-card-inner.plate-turn,
		.project-card-inner.plate-turn:hover,
		.project-card-inner.plate-turn:focus-within {
			transition: none;
			transform: none;
		}

		.plate-turn-ghost {
			transition: opacity 0.3s ease-out;
			transform: none;
		}
	}

	/*
	 * FEATURE variant — the screenshot is a framed artifact sitting high and
	 * right on the plate, not a background wash. It used to be cropped by the
	 * plate on two edges, which read as an image that had failed to load rather
	 * than as a deliberate crop; it is fully bounded now and the asymmetry comes
	 * from where it sits instead.
	 */
	.project-screenshot {
		@apply pointer-events-none absolute top-8 right-0 z-[1] inline-block w-[130%] max-w-none rounded-xl align-middle max-sm:left-0 sm:top-10 sm:right-auto sm:w-11/12 sm:max-w-full lg:top-12 lg:right-12 lg:w-[58%];

		border: 1px solid rgb(255 255 255 / 15%);

		@media screen and (orientation: landscape) and (hover: none) {
			@apply top-8 right-8 w-[55%];
		}
	}

	@media screen and (orientation: landscape) and (hover: none) {
		.project-card-link {
			@apply flex;
		}
	}

	.project-card-button-label {
		@apply text-base-content relative z-10 px-6 text-xs leading-tight;

		@media screen and (orientation: landscape) and (hover: none) {
			@apply text-2xl;
		}
	}

	/* SPLIT variant — screenshot framed left, copy right */
	.project-card-variant-split {
		@apply justify-center;
	}

	.split-screenshot-frame {
		max-height: 60vh;
		border: 1px solid rgb(255 255 255 / 15%);
		background: rgb(0 0 0 / 20%);
	}

	@media (width >= theme(--breakpoint-sm)) {
		.split-screenshot-frame {
			max-height: none;
		}
	}

	/* POSTER variant — screenshot fills the plate, copy sits bottom-left.
	   The masthead moved down out of the centre because these screenshots
	   carry their own headline artwork, and two display headlines stacked
	   in one frame read as a mistake. */
	.project-card-variant-poster {
		@apply justify-end;
	}

	.poster-screenshot {
		@apply pointer-events-none absolute inset-0 z-0 h-full w-full max-w-none object-cover;
	}

	/* Flat, not a gradient. It exists to buy contrast for the copy. */
	.poster-scrim {
		@apply pointer-events-none absolute inset-0 z-[1];

		background: rgb(0 0 0 / 55%);
	}
</style>
