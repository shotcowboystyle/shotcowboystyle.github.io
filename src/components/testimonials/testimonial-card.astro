---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	testimonial: CollectionEntry<'testimonial'>;
}

const { data } = Astro.props.testimonial;
---

<p class="testimonial-text my-0 max-w-[62ch] text-base sm:text-lg">
	{data.testimonial}
</p>

<!--
	One row, avatar first, text beside it. The row is pushed to the right edge so
	it clears the swiper nav buttons, which sit absolutely in the bottom-left of
	the card; name and byline share a flush right edge.
-->
<div class="mb-8 flex flex-row items-center justify-end gap-4">
	<div class="avatar shrink-0">
		<div class="w-12 overflow-hidden rounded-full sm:w-14">
			<Image
				src={data.avatar}
				widths={[72, 144, data.avatar.width]}
				alt={data.name}
			/>
		</div>
	</div>

	<div class="flex min-w-0 flex-col justify-end text-right">
		<span class="testimonial-name font-sans text-sm leading-tight font-bold uppercase sm:text-base">
			{data.name}
		</span>
		<span class="testimonial-byline text-xs leading-tight font-medium sm:text-sm">
			{data.designation}, {data.companyName}
		</span>
	</div>
</div>

<style>
	@reference "../../styles/base.css";

	@media screen and (orientation: landscape) and (hover: none) {
		.testimonial-text {
			@apply mb-16;
		}
	}
</style>
