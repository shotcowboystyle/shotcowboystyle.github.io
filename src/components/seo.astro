---
/**
 * Common head elements
 */
import { getCollection } from 'astro:content';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const site = new URL('/', Astro.site).href;
const socials = await getCollection('social');

/**
 * Who the site is about, for search engines and AI answer tools. Folios point
 * their `creator` at this `@id`, so each project is attributed to one person.
 */
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${site}#person`,
			name: 'Curtis Blanton',
			alternateName: 'shotcowboystyle',
			jobTitle: 'Full-stack developer',
			url: site,
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Charleston',
				addressRegion: 'SC',
				addressCountry: 'US',
			},
			sameAs: socials.map((social) => social.data.link),
		},
		{
			'@type': 'WebSite',
			'@id': `${site}#website`,
			name: 'Curtis Blanton',
			url: site,
			author: { '@id': `${site}#person` },
		},
	],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />

<meta
	name="robots"
	content="index,follow"
/>
<meta
	name="theme-color"
	content="#000000"
/>
<meta
	name="application-name"
	content="shotcowboystyle"
/>
<meta
	name="viewport"
	content="width=device-width,initial-scale=1.0,minimum-scale=1.0"
/>

<link
	rel="apple-touch-icon"
	sizes="180x180"
	href="/icon/apple-touch-icon.png"
/>
<link
	rel="icon"
	type="image/png"
	sizes="32x32"
	href="/icon/favicon-32x32.png"
/>
<link
	rel="icon"
	type="image/png"
	sizes="16x16"
	href="/icon/favicon-16x16.png"
/>
<link
	rel="shortcut icon"
	href="/favicon.ico"
	type="image/x-icon"
/>

<link
	rel="canonical"
	href={canonicalURL}
/>
<link
	rel="manifest"
	href="/icon/site.webmanifest"
/>

<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify(structuredData)}
/>
