---
import { getCollection } from 'astro:content';

const roles = (await getCollection('cv')).sort((a, b) => b.data.start.localeCompare(a.data.start));

/** `2018-04` → `2018`, and an open-ended role reads as running to now. */
const years = (start: string, end?: string) =>
	`${start.slice(0, 4)}–${end ? end.slice(2, 4) : 'Now'}`;
---

<div class="cv-card flex h-full flex-col gap-6 p-6 sm:p-8 xl:p-10">
	<h2 class="text-4xl sm:text-5xl">CV</h2>

	<ol class="cv-ledger grid grid-cols-[auto_1fr] gap-x-4 gap-y-3 sm:gap-y-4">
		{
			roles.map(({ data }) => (
				<li class="col-span-full grid grid-cols-subgrid text-sm leading-snug sm:text-base">
					<span class="cv-years">{years(data.start, data.end)}</span>
					<span>
						<span class="block font-bold">{data.company}</span>
						<span class="block">{data.role}</span>
					</span>
				</li>
			))
		}
	</ol>

	<a
		href="/downloads/Resume.pdf"
		class="cv-link mt-auto self-start text-sm font-bold uppercase sm:text-base"
		download
	>
		Full CV (PDF)
	</a>
</div>

<style>
	/*
	 * One year column shared by every row (each row is a subgrid), so "2023–Now" and
	 * "2018–23" line their company names up on the same edge. In a narrow cell
	 * the column folds away and the years sit above each role instead.
	 */
	.cv-card {
		container-type: inline-size;
	}

	@container (width < 14rem) {
		.cv-ledger {
			grid-template-columns: 1fr;
		}
	}

	/* `nowrap` so "2023–Now" holds one line instead of breaking at the dash. */
	.cv-years {
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	/* The Tertiary tier: an uppercase label whose underline is the affordance. */
	.cv-link {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		cursor: pointer;
	}

	.cv-link:hover {
		text-decoration-thickness: 2px;
	}
</style>
