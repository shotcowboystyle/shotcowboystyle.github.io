---
import BackToTop from '@/components/about/back-to-top.astro';
import Bio from '@/components/about/bio.astro';
import Cv from '@/components/about/cv.astro';
import GoodiesCard from '@/components/about/goodies-card.astro';
import Location from '@/components/about/location.astro';
import MysteryBox from '@/components/about/mystery-box.astro';
import Contact from '@/components/contact.astro';
---

<div
	id="about-wrapper"
	class="pointer-events-none relative grid h-auto w-full auto-cols-[1fr] grid-cols-[1fr] grid-rows-[auto] gap-8 p-6 min-[45rem]:gap-5 min-[45rem]:p-4 lg:gap-6 lg:p-5 min-[45rem]:grid-cols-[1fr_1fr_1fr] min-[45rem]:grid-rows-[auto_auto_auto_auto] lg:min-h-screen lg:grid-cols-[1fr_1fr_1fr_1fr] lg:grid-rows-[auto_auto_auto]"
>
	<div
		id="about-box-bio"
		class="bg-primary text-primary-content pointer-events-auto relative grid auto-cols-[1fr] grid-flow-row grid-cols-[1fr] grid-rows-[auto] gap-10 overflow-hidden rounded-2xl px-6 pt-16 pb-4 select-auto sm:p-6 lg:p-8 2xl:grid-flow-col 2xl:grid-cols-[1fr_1fr]"
	>
		<Bio />
	</div>

	<section
		id="cv"
		aria-label="CV"
		class="bg-accent pointer-events-auto relative flex flex-col overflow-hidden rounded-2xl"
	>
		<Cv />
	</section>

	<div
		id="about-box-location"
		class="grid-about-box pointer-events-auto min-h-[360px] !p-0 sm:min-h-[20vh] lg:min-h-[30vh]"
	>
		<Location />
	</div>

	<div
		id="about-box-goodies"
		class="grid-about-box pointer-events-auto min-h-[360px] !p-0 sm:min-h-[20vh] lg:min-h-[30vh]"
	>
		<GoodiesCard />
	</div>

	<div
		id="about-box-mystery-box"
		class="grid-about-box pointer-events-auto min-h-[360px] !overflow-visible !bg-transparent !p-0 sm:min-h-[20vh] lg:min-h-[30vh]"
	>
		<MysteryBox />
	</div>

	<div
		id="back-to-top"
		class="grid-about-box !bg-warning !text-warning-content @container pointer-events-auto !grid !auto-cols-[1fr] !grid-flow-col !grid-cols-[auto_auto] !grid-rows-[auto] !gap-4 overflow-hidden !p-0 transition-transform hover:scale-105 xl:min-h-[25vh]"
	>
		<BackToTop />
	</div>

	<div
		id="about-box-contact"
		class="grid-about-box !bg-info !text-info-content pointer-events-auto !p-0 transition-transform hover:scale-105 sm:!p-4 lg:!p-0"
	>
		<Contact />
	</div>
</div>

<style>
	@reference "../../styles/base.css";

	/*
	 * Where the bento is taller than the screen, spacing and type scale with
	 * viewport width, like the reference. Tailwind utilities read these theme
	 * variables, so they rescale only the bento; without `--bento-rem` they
	 * equal Tailwind's defaults.
	 */
	#about-wrapper {
		--spacing: calc(var(--bento-rem, 1rem) * 0.25);
		--radius-2xl: var(--bento-rem, 1rem);
		--text-xs: calc(var(--bento-rem, 1rem) * 0.75);
		--text-sm: calc(var(--bento-rem, 1rem) * 0.875);
		--text-base: var(--bento-rem, 1rem);
		--text-lg: calc(var(--bento-rem, 1rem) * 1.125);
		--text-xl: calc(var(--bento-rem, 1rem) * 1.25);
		--text-2xl: calc(var(--bento-rem, 1rem) * 1.5);
		--text-3xl: calc(var(--bento-rem, 1rem) * 1.875);
		--text-4xl: calc(var(--bento-rem, 1rem) * 2.25);
		--text-5xl: calc(var(--bento-rem, 1rem) * 3);
		--text-6xl: calc(var(--bento-rem, 1rem) * 3.75);

		/*
		 * Portrait tablets: 11.9px on an iPad mini (744×1133); vh caps shorter
		 * ones. The grid fills the screen and the two small-card rows split the
		 * leftover height evenly instead of each hugging its content.
		 */
		@media (width >= 45rem) and (width < theme(--breakpoint-lg)) and (orientation: portrait) {
			--bento-rem: min(1.6vw, 1.05vh);

			grid-template-rows: auto auto 1fr 1fr;
			height: 100vh;
		}

		/* Wide-but-short screens: the reference's 0.9vw, 10.2px at 1133×744. */
		@media (width >= theme(--breakpoint-lg)) and (height <= 900px) {
			--bento-rem: 0.9vw;
		}
	}

	/*
	 * Mirrors diegolivworks.webflow.io: one column on phones, a 3×4 bento on
	 * tablets, and the 4×3 bento from lg up. The tablet layout starts at 45rem
	 * rather than md (48rem) so an iPad mini (744px) gets it in portrait.
	 */
	#about-box-bio {
		@media (width >= 45rem) {
			grid-area: 1 / 1 / 3 / 3;
		}
	}

	#cv {
		@media (width >= 45rem) {
			grid-area: 1 / 3 / 3 / 4;
		}
	}

	#about-box-location {
		@media (width >= 45rem) {
			grid-area: 3 / 1 / 4 / 2;
		}
	}

	#about-box-goodies {
		@media (width >= 45rem) {
			grid-area: 3 / 2 / 4 / 3;
		}
	}

	#about-box-mystery-box {
		@media (width >= 45rem) {
			grid-area: 4 / 1 / 5 / 2;
		}

		@media (width >= theme(--breakpoint-lg)) {
			grid-area: 3 / 3 / 4 / 4;
		}
	}

	#back-to-top {
		grid-area: 7 / 1 / 9 / 2;

		@media (width >= 45rem) {
			grid-area: 4 / 2 / 5 / 3;
		}

		@media (width >= theme(--breakpoint-lg)) {
			grid-area: 1 / 4 / 2 / 5;
		}
	}

	#about-box-contact {
		grid-area: 6 / 1 / 7 / 2;

		@media (width >= 45rem) {
			grid-area: 3 / 3 / 5 / 4;
		}

		@media (width >= theme(--breakpoint-lg)) {
			grid-area: 2 / 4 / 4 / 5;
		}
	}

	.grid-about-box {
		@apply text-base-content relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white p-10 text-sm;
	}
</style>
