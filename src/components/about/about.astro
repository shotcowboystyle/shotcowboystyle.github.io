---
import BackToTop from '@/components/about/back-to-top.astro';
import Bio from '@/components/about/bio.astro';
import Location from '@/components/about/location.astro';
import MysteryBox from '@/components/about/mystery-box.astro';
import SocialCard from '@/components/about/social-card.astro';
import Contact from '@/components/contact.astro';
import Testimonials from '@/components/testimonials/testimonials.astro';

// import { getCollection } from 'astro:content';

// const testimonials = await getCollection('testimonial');
// const featured = testimonials.sort((a, b) => a.data.order - b.data.order)[0];
---

<div
	id="about-wrapper"
	class="pointer-events-none relative grid h-auto w-full auto-cols-[1fr] grid-cols-[1fr] grid-rows-[auto] gap-8 p-5 sm:min-h-screen sm:grid-cols-[1fr_1fr_1fr] sm:grid-rows-[auto_auto_auto_auto] sm:gap-10 sm:p-8 lg:grid-cols-[1fr_1fr_1fr_1fr] lg:grid-rows-[auto_auto_auto] lg:gap-8 lg:p-6"
>
	<div
		id="about-box-bio"
		class="bg-primary text-primary-content pointer-events-auto relative grid auto-cols-[1fr] grid-flow-row grid-cols-[1fr] grid-rows-[auto] gap-10 overflow-hidden rounded-2xl px-6 pt-16 pb-4 select-auto sm:rounded-3xl sm:p-12 lg:grid-flow-col lg:grid-cols-[1fr_1fr] xl:p-10"
	>
		<Bio />
	</div>

	<div
		id="about-box-testimonials"
		class="bg-accent pointer-events-auto relative flex flex-col overflow-hidden rounded-2xl p-0 sm:rounded-3xl sm:p-4 xl:p-0"
	>
		<Testimonials />
	</div>

	<div
		id="about-box-location"
		class="grid-about-box pointer-events-auto min-h-[360px] !p-0 sm:min-h-[20vh] lg:min-h-[30vh]"
	>
		<Location />
	</div>

	<div
		id="about-box-social-card"
		class="grid-about-box pointer-events-auto min-h-[360px] !p-0 sm:min-h-[20vh] lg:min-h-[30vh]"
	>
		<SocialCard />
	</div>

	<div
		id="about-box-mystery-box"
		class="grid-about-box pointer-events-auto min-h-[360px] !overflow-visible !p-0 sm:min-h-[20vh] lg:min-h-[30vh]"
	>
		<MysteryBox />
	</div>

	<div
		id="back-to-top"
		class="grid-about-box !bg-warning !text-warning-content pointer-events-auto !grid !auto-cols-[1fr] !grid-flow-col !grid-cols-[auto_auto] !grid-rows-[auto] !gap-4 overflow-hidden !p-0 transition-transform hover:scale-105 sm:!p-4 lg:min-h-[25vh] lg:!p-0"
	>
		<BackToTop />
	</div>

	<div
		id="about-box-contact"
		class="grid-about-box !bg-info !text-info-content pointer-events-auto !p-0 transition-transform hover:scale-105 sm:!p-4 lg:!p-0"
	>
		<Contact />
	</div>
</div>

<style>
	@reference "../../styles/base.css";

	@media screen and (orientation: landscape) and (hover: none) {
		#about-wrapper {
			@apply h-auto grid-cols-[1fr_1fr_1fr] grid-rows-[auto] gap-8 p-5;
		}
	}

	#about-box-bio {
		grid-area: span 1 / span 1 / span 1 / span 1;

		@media (width >= theme(--breakpoint-sm)) {
			grid-area: 1 / 1 / 3 / 3;
		}

		@media screen and (orientation: landscape) and (hover: none) {
			grid-area: 1 / span 3 / 1 / span 3;
		}
	}

	#about-box-testimonials {
		grid-area: span 1 / span 1 / span 1 / span 1;

		@media (width >= theme(--breakpoint-sm)) {
			grid-area: 1 / 3 / 3 / 4;
		}

		@media screen and (orientation: landscape) and (hover: none) {
			grid-area: 2 / span 3 / 2 / span 3;
		}
	}

	#about-box-location {
		grid-area: span 1 / span 1 / span 1 / span 1;

		@media (width >= theme(--breakpoint-sm)) {
			grid-area: 3 / 1 / 4 / 2;
		}

		@media screen and (orientation: landscape) and (hover: none) {
			@apply min-h-[240px];

			grid-area: span 2 / 1 / span 2 / 1;
		}
	}

	#about-box-social-card {
		grid-area: span 1 / span 1 / span 1 / span 1;

		@media (width >= theme(--breakpoint-sm)) {
			grid-area: 3 / 2 / 4 / 3;
		}

		@media screen and (orientation: landscape) and (hover: none) {
			@apply min-h-[240px];

			grid-area: span 2 / 2 / span 2 / 2;
		}
	}

	#about-box-mystery-box {
		grid-area: span 1 / span 1 / span 1 / span 1;

		@media (width >= theme(--breakpoint-sm)) {
			grid-area: 4 / 1 / 5 / 2;
		}

		@media (width >= theme(--breakpoint-lg)) {
			grid-area: 3 / 3 / 4 / 4;
		}

		@media screen and (orientation: landscape) and (hover: none) {
			@apply min-h-[240px];

			grid-area: span 2 / 3 / span 2 / 3;
		}
	}

	#back-to-top {
		grid-area: 7 / 1 / 9 / 2;

		@media (width >= theme(--breakpoint-sm)) {
			grid-area: 4 / 2 / 5 / 3;
		}

		@media (width >= theme(--breakpoint-lg)) {
			grid-area: 1 / 4 / 2 / 5;
		}

		@media screen and (orientation: landscape) and (hover: none) {
			grid-area: 5 / 3 / 6 / 3;
		}
	}

	#about-box-contact {
		grid-area: 6 / 1 / 7 / 2;

		@media (width >= theme(--breakpoint-sm)) {
			grid-area: 3 / 3 / 5 / 4;
		}

		@media (width >= theme(--breakpoint-lg)) {
			grid-area: 2 / 4 / 4 / 5;
		}

		@media screen and (orientation: landscape) and (hover: none) {
			grid-area: 5 / span 2 / 6 / span 2;
		}
	}

	.grid-about-box {
		@apply text-base-content relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white p-10 text-sm;

		@media (width >= theme(--breakpoint-sm)) {
			@apply rounded-3xl;
		}
	}
</style>
