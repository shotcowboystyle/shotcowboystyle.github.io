---
import { layoutQuestionMark } from '@/components/about/question-mark';
import SvgSprite from '@/components/SvgSprite.astro';

/**
 * Indexed by position on the glyph: hook start, hook crown, the bend into the
 * stem, and the period. Pulse periods are deliberately unrelated so the four
 * never settle into a visible rhythm.
 */
const LINKS = [
	{
		id: 'programming-motherfucker-site-link',
		href: 'https://programming-motherfucker.com/',
		label: 'Programming Motherfucker',
		icon: 'crosshair',
		variant: 'stroke',
		pulse: '3.1s',
		delay: '1.1s',
	},
	{
		id: 'bonsai-studio-link',
		href: 'https://www.charlestonbonsaico.com/studio',
		label: 'Bonsai Studio',
		icon: 'star',
		variant: 'fill',
		pulse: '4.7s',
		delay: '2.6s',
	},
	{
		id: 'tower-blocks-page-link',
		href: '/tower-blocks/',
		label: 'Tower Blocks',
		icon: 'blocks',
		variant: 'stroke',
		pulse: '5.3s',
		delay: '1.9s',
	},
	{
		id: 'ecograder-site-link',
		href: 'https://ecograder.com/report/7zE0m82a4iDVB61tj0srYvLY',
		label: 'Ecograder report for this site',
		tip: 'Ecograder',
		icon: 'leaf',
		variant: 'fill',
		pulse: '3.9s',
		delay: '1.5s',
	},
];

const dots = layoutQuestionMark().map((dot) => ({
	...dot,
	style: `--d:${dot.size};--x:${dot.x};--y:${dot.y};--r:${dot.r}deg;--sx:${dot.sx};--sy:${dot.sy}`,
}));
---

<div class="mystery-box-card h-full">
	{
		dots.map((dot) => {
			if (dot.link === undefined)
				return (
					<span
						class="dot"
						style={dot.style}
					/>
				);

			const link = LINKS[dot.link];
			const external = link.href.startsWith('http');
			return (
				<a
					href={link.href}
					aria-label={link.label}
					id={link.id}
					class="dot link"
					style={`${dot.style};--pulse:${link.pulse};--delay:${link.delay}`}
					{...(external && { target: '_blank', rel: 'noopener noreferrer' })}
				>
					<span
						class="lg:tooltip"
						data-tip={link.tip ?? link.label}
						aria-hidden="true"
					>
						<SvgSprite
							name={link.icon}
							class={`svg ${link.variant}`}
						/>
					</span>
				</a>
			);
		})
	}
</div>

<style>
	@reference "../../styles/base.css";

	/*
	 * Every block is centre-anchored at the middle of the card and placed by
	 * transform alone. Formed coordinates are % of a square stage (`--s`) so the
	 * glyph keeps its proportions at any card aspect ratio; scattered ones are %
	 * of the card. The geometry itself lives in `question-mark.ts`.
	 */
	.mystery-box-card {
		--s: min(80cqw, 80cqh);

		@apply relative w-full overflow-hidden rounded-2xl;

		container-type: size;
		background-color: var(--color-surface-sunken);

		@supports (corner-shape: squircle) {
			corner-shape: squircle;
		}

		@media (width >= theme(--breakpoint-sm)) {
			@apply rounded-3xl;
		}
	}

	.dot {
		--formed: translate(
				calc((var(--x) - 50) * var(--s) / 100),
				calc((var(--y) - 50) * var(--s) / 100)
			)
			rotate(var(--r));

		position: absolute;
		top: 50%;
		left: 50%;
		width: calc(var(--d) * var(--s) / 100);
		aspect-ratio: 1;
		border-radius: 28%;
		background: rgb(255 255 255 / 70%);
		transition:
			transform 1s ease-in-out,
			scale 0.2s ease-in-out,
			rotate 0.2s ease-in-out;
		transform: var(--formed);
		translate: -50% -50%;

		/* Touch never hovers, so it only ever sees the formed glyph. */
		@media (hover: hover) and (pointer: fine) {
			transform: translate(calc((var(--sx) - 50) * 1cqw), calc((var(--sy) - 50) * 1cqh));
		}
	}

	.mystery-box-card:is(:hover, :focus-within) .dot {
		transform: var(--formed);

		&:not(.link):hover {
			scale: 1.8;
		}
	}

	.link {
		display: grid;
		place-content: center;
		border: 1px solid rgb(255 255 255);
		animation: link-pulse var(--pulse) ease-out var(--delay) infinite;

		&::before {
			content: '';
			position: absolute;
			inset: 0;
			border-radius: inherit;
			background: rgb(0 0 0);
			opacity: 0%;
			transition: opacity 0.2s ease-in-out;
		}

		.svg {
			@apply relative h-2.5 w-2.5;

			transition: all 0.2s ease-in-out;
		}

		.svg.fill {
			@apply fill-white/[0.00];
		}

		.svg.stroke {
			@apply stroke-white/[0.00];
		}
	}

	/* Pulse only while the glyph is formed, and not under the pointer. */
	@media (hover: hover) and (pointer: fine) {
		.mystery-box-card:not(:hover, :focus-within) .link {
			animation: none;
		}
	}

	.link:hover {
		border-color: transparent;
		rotate: 3deg;
		scale: 1.25;
		animation: none;

		&::before {
			opacity: 100%;
		}

		.svg.fill {
			fill: rgb(255 255 255);
		}

		.svg.stroke {
			stroke: rgb(255 255 255);
		}
	}

	@keyframes link-pulse {
		0%,
		14%,
		100% {
			box-shadow: 0 0 0 0 rgb(255 255 255 / 0%);
			scale: 1;
		}

		5% {
			box-shadow: 0 0 0 0 rgb(255 255 255 / 60%);
			scale: 1.35;
		}

		12% {
			box-shadow: 0 0 0 0.6em rgb(255 255 255 / 0%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.link {
			animation: none;
		}

		.link:hover {
			rotate: none;
			scale: none;
		}
	}
</style>
