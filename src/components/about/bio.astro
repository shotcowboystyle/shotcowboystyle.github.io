---
const stack = [
	'TypeScript',
	'React',
	'Vue',
	'Astro',
	'Node.js',
	'.NET',
	'GSAP',
	'Three.js',
	'Shopify',
	'Supabase',
	'Stripe',
	'Zapier',
];
---

<!--
  Two top-level children on purpose: the parent grid in about.astro switches to
  `grid-flow-col grid-cols-[1fr_1fr]` at sm, so headline and copy become the two
  columns. Wrapping them in a single div collapses that back to one column.
-->
<div class="flex flex-col justify-end">
	<h2
		id="bio-headline"
		class="mb-0 font-bold sm:max-w-[18ch]"
	>
		I’m Curtis, A full-stack developer based in Charleston, SC.
	</h2>
</div>

<div class="flex flex-col justify-end gap-6">
	<p
		id="bio-description"
		class="text-base-content mb-0 max-w-[62ch] font-sans text-base font-medium sm:text-lg"
	>
		Fifteen-plus years shipping scalable web work — product UI, marketing sites, and interactive
		brand pieces. Comfortable across the stack, senior-IC by preference, deadline-driven by habit.
	</p>

	<ul
		class="bio-stack flex flex-wrap items-center gap-2 sm:gap-3"
		aria-label="Selected stack"
	>
		{
			stack.map((tag) => (
				<li class="border-primary-content/40 rounded-full border px-3 py-1 font-sans text-xs tracking-wide uppercase sm:text-sm">
					{tag}
				</li>
			))
		}
	</ul>
</div>

<style>
	/*
	 * `@reference` is what compiles `theme()` here. Without it this block shipped
	 * a literal `theme(--breakpoint-md)` into the stylesheet: browsers dropped
	 * the at-rule, so these desktop sizes never applied and the card overflowed
	 * its fixed-height grid cell — and lightningcss aborted on the invalid
	 * token, which silently disabled CSS minification for the whole bundle.
	 */
	@reference "../../styles/base.css";

	@media (width >= theme(--breakpoint-md)) and (hover: hover) and (pointer: fine) {
		#bio-headline {
			@apply text-5xl;
		}
	}
</style>
