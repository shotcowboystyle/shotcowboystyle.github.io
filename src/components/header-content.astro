---
import openProjectsBadge from '@/assets/open-projects-badge.svg';
import Availability from '@/components/availability.astro';
import ResumeButton from '@/components/resume-button.astro';
import SvgSprite from '@/components/SvgSprite.astro';
import { CONTACT_MAILTO_HREF } from '@/utils/email.server';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const socials = await getCollection('social');
---

<div
	id="header-content-wrapper"
	class="bg-base-100 flex w-full flex-col justify-between rounded-2xl p-5 text-black sm:rounded-3xl sm:p-24 lg:p-20"
>
	<div class="flex items-center justify-between">
		<a
			href="/"
			aria-current="page"
			class="c-animated-text js-split-lines js-animation-reveal-text-wrapper font-sans-serif text-2xl leading-none font-bold tracking-tight uppercase sm:text-3xl"
		>
			shotcowboystyle.
		</a>

		<div
			class="pointer-events-auto grid auto-cols-auto grid-flow-col grid-cols-[auto] grid-rows-[auto] content-center items-center justify-end justify-items-end gap-8"
		>
			<div class="hidden sm:block">
				<Availability />
			</div>

			<a
				id="lets-talk-button"
				href={CONTACT_MAILTO_HREF}
				class="js-inject-email-link group btn btn-circle btn-neutral relative flex h-20 w-20 items-center justify-center bg-black text-center text-base !leading-none font-medium text-white sm:h-32 sm:w-32 lg:h-24 lg:w-24"
			>
				<span
					id="lets-talk-label"
					class="relative z-[1] text-white normal-case max-sm:text-xs max-sm:!leading-4 sm:text-lg sm:!leading-none"
				>
					Let's<br />Talk
				</span>

				<span
					class="absolute inset-0 z-0 rounded-full bg-black transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-150"
				></span>
			</a>
		</div>
	</div>

	<div class="relative">
		<div
			class="header-content-content-wrapper mb-6 flex items-start max-lg:flex-col lg:mb-16 lg:items-end"
		>
			<div class="c-animated-big-text__text relative">
				<!--
					The mobile width cap was `max-w-[8ch]`, measured against a condensed
					display face. `ch` is the width of the font's own zero, so the same 8ch
					is far narrower in Geist: "Developer." overran the box, and the line
					clipper's `overflow: hidden` then cut it mid-letter.
				-->
				<div class="anim-h1-wrapper">
					<h1
						id="header-headline"
						class="c-animated-text js-split-lines js-animation-reveal-text-wrapper hero-gradient-text mb-2 !leading-[.9] uppercase sm:mb-0 sm:max-w-[14ch]"
					>
						Full Stack<br />Senior Developer.
					</h1>
				</div>
			</div>

			<div class="sm:hidden">
				<Availability />
			</div>

			<div class="flex flex-col items-start gap-8 lg:ml-auto lg:items-end">
				<!--
					Was `scale-0 opacity-0` waiting on an entrance animation that was never
					written, so the availability badge had never rendered. It states a fact
					the visitor needs, so it ships visible and animates only its rotation.
					It sits beside the intro rather than over the headline, where it used to
					land on top of the type at display sizes.
				-->
				<div
					id="header-badge"
					class="pointer-events-none hidden h-24 w-24 sm:block md:h-32 md:w-32 lg:h-28 lg:w-28"
				>
					<Image
						src={openProjectsBadge}
						alt="Open for new projects"
						widths={[108, 216, openProjectsBadge.width]}
						class="motion-safe:animate-spin-circle inline-block max-w-full align-middle"
					/>
				</div>

				<p
					id="header-intro"
					class="c-animated-text js-split-words js-animation-reveal-text-wrapper mt-4 mb-0 max-w-[28ch] sm:mb-16 lg:mb-4 lg:text-right"
				>
					Motion is the language. Fifteen years of shipping considered work for teams that treat
					craft as evidence.
				</p>
			</div>
		</div>

		<nav
			id="header-links-wrapper"
			aria-label="Primary"
			class="pointer-events-auto relative flex justify-between"
		>
			<div
				id="header-links"
				class="grid auto-cols-[1fr] grid-flow-row grid-cols-[auto] grid-rows-[auto] items-center gap-y-8 sm:auto-cols-auto sm:grid-flow-col sm:!gap-4"
			>
				<ul
					class="header-social-links m-0 grid list-none auto-cols-auto grid-flow-col grid-cols-[auto] grid-rows-[auto] items-center justify-start gap-4 p-0"
				>
					{
						socials.map((social) => (
							<li class="inline-flex">
								<a
									aria-label={`Visit my ${social.data.name} profile`}
									href={social.data.link}
									target="_blank"
									rel="me noopener noreferrer"
									class="inline-flex h-11 w-11 items-center justify-center sm:h-11 sm:w-11 lg:h-8 lg:w-8"
								>
									<SvgSprite
										name={social.data.icon}
										class="h-5 w-5 stroke-black sm:h-8 sm:w-8 lg:h-5 lg:w-5"
										aria-hidden="true"
									/>
								</a>
							</li>
						))
					}
				</ul>

				<div class="flex items-center gap-4 sm:gap-5">
					<a
						class="scroll-link text-sm font-medium uppercase underline-offset-4 hover:underline"
						href="#about"
						id="about-button"
					>
						About Me
					</a>

					<ResumeButton />
				</div>
			</div>

			<div
				id="scroll-animation"
				class="js-lottie-animation absolute right-0 bottom-0 w-12 sm:w-16"
				data-animation-name="scroll-animation"
				data-animation-source="/animation/lottie-scroll.json"
				data-animation-play-control="autoplay"
				data-animation-loop="true"
				aria-hidden="true"
			>
			</div>
		</nav>
	</div>
</div>

<style>
	@reference "../styles/base.css";

	@media screen and (orientation: portrait) and (hover: none) {
		.header-content-content-wrapper {
			@apply mb-4;
		}
	}

	@media screen and (orientation: landscape) and (hover: none) {
		#header-content-wrapper {
			@apply p-12;
		}

		#header-intro {
			@apply mb-2;
		}
	}

	#header-links {
		@media screen and (orientation: portrait) and (hover: none) {
			@apply gap-5;
		}
	}

	.header-social-links {
		grid-area: 2 / 1 / 3 / 2;

		@media (width >= theme(--breakpoint-md)) {
			grid-area: auto;
		}

		@media screen and (orientation: landscape) and (hover: none) {
			grid-area: auto;
		}

		svg {
			@apply fill-neutral;
		}
	}
</style>
