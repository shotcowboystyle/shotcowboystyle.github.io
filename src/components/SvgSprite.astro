---
export interface Props {
	name: string;
	class?: string;
	width?: string;
	height?: string;
}

const { class: className, name, ...rest } = Astro.props;
---

<svg
	class={className}
	{...rest}
>
	{
		/*
		 * Root-relative, not `${Astro.site}…`. An absolute URL makes every icon a
		 * cross-origin `<use>` the moment the page is served from any host other
		 * than the one hardcoded in `astro.config.mjs` — preview deploys, a custom
		 * domain, or a dev server that had to fall back off port 4321. Browsers
		 * block that fetch and the symbol renders empty.
		 */
	}
	<use href={`/assets/images/sprite.svg#${name}`}></use>
</svg>
