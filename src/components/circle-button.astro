---
import CircleButtonStars from '@/components/circle-button-stars.astro';

interface Props {
	link: string;
	label: string;
	external?: boolean;
}

const { link, label, external } = Astro.props;
const isExternal = external ?? /^https?:\/\//.test(link);

/**
 * The ring carries a short fixed phrase rather than the full CTA label. The
 * label runs "Read the story: <Project Title>", which at ~30 characters wrapped
 * past the halfway point of the path and rendered the back half of the sentence
 * upside down — legible only by tilting your head. A short phrase repeated
 * twice reads the same from every angle because both copies are short enough to
 * stay near the top of the arc as it turns.
 *
 * The path is an r=42 circle, so its circumference is 2πr ≈ 264 units; at
 * `font-size: 9` roughly 52 characters fit before glyphs start colliding.
 */
const RING_PHRASE = 'Read the story';
const RING_SEPARATOR = ' • ';
const RING_PATH_CAPACITY_IN_CHARACTERS = 52;

const ringRepeatCount = Math.max(
	1,
	Math.floor(RING_PATH_CAPACITY_IN_CHARACTERS / (RING_PHRASE.length + RING_SEPARATOR.length)),
);
const ringText = `${Array.from({ length: ringRepeatCount }, () => RING_PHRASE).join(RING_SEPARATOR)}${RING_SEPARATOR}`;
---

<!--
	The wrapper used to carry `shadow-[0_0_20px_10px] shadow-white/30`, a white
	glow at rest that read as a bloom artifact rather than elevation. Depth here
	comes from the ring and the plate contrast.
-->
<div class="notify-button-wrapper relative hidden rounded-full p-8 sm:block">
	<a
		class="notify-button-button relative flex h-32 w-32 items-center justify-center rounded-full border-2 border-neutral-50"
		href={link}
		target={isExternal ? '_blank' : undefined}
		rel={isExternal ? 'noopener noreferrer' : undefined}
	>
		<span
			class="absolute inset-0 overflow-hidden rounded-full"
			aria-hidden="true"
		>
			<svg
				width="100%"
				viewBox="0 0 50 50"
				aria-hidden="true"
				focusable="false"
			>
				<g class="notify-button-space">
					<g transform="translate(0,0)">
						<CircleButtonStars />
					</g>

					<g transform="translate(0,-50)">
						<CircleButtonStars />
					</g>

					<g transform="translate(50,0)">
						<CircleButtonStars />
					</g>

					<g transform="translate(50,-50)">
						<CircleButtonStars />
					</g>
				</g>

				<g class="notify-button-stream">
					<g
						stroke-width="0.8"
						stroke-linecap="round"
						stroke="currentColor"
					>
						<line
							x1="11"
							y1="25"
							x2="0"
							y2="35"
						>
						</line>
						<line
							x1="25"
							y1="39"
							x2="15"
							y2="50"
						>
						</line>
					</g>
					<g class="fill-current">
						<circle
							cx="11"
							cy="25"
							r="1"
						>
						</circle>
						<circle
							cx="25"
							cy="39"
							r="1"
						>
						</circle>
					</g>
				</g>
			</svg>
		</span>

		<!--
			Was a paper-plane glyph, which reads as "send" — the wrong promise for a
			link that opens a case study. An arrow leaving the corner is the plain
			statement of what the control does.
		-->
		<span
			class="notify-button-plane block"
			aria-hidden="true"
		>
			<svg
				width="72"
				height="72"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.25"
				aria-hidden="true"
				focusable="false"
			>
				<path d="M7 17 17 7"></path>
				<path d="M8.5 7H17v8.5"></path>
			</svg>
		</span>
		<span class="sr-only">{label}</span>
	</a>

	<!--
		`animate-spin-slow` was never defined in the theme, so the ring only ever
		turned on hover. The rotation is the affordance — it says the ring is a
		control — so it now runs from the theme's own 8s keyframe, motion-safe.
	-->
	<div
		class="ring-rotor pointer-events-none absolute inset-2 motion-safe:animate-[spinCircle_8s_linear_infinite]"
		aria-hidden="true"
	>
		<svg
			width="100%"
			viewBox="0 0 100 100"
			aria-hidden="true"
			focusable="false"
		>
			<text
				class="fill-current font-medium"
				font-size="9"
				letter-spacing="0.5"
			>
				<textPath href="#text-path">{ringText}</textPath>
			</text>
			<path
				d="M 50 8 a 42 42 0 0 1 0 84 a 42 42 0 0 1 0 -84 z"
				id="text-path"
				class="fill-none"
			>
			</path>
		</svg>
	</div>
</div>

<style>
	@media screen and (orientation: landscape) and (hover: none) {
		.notify-button-wrapper {
			display: none;
		}
	}

	.notify-button-space {
		transition: opacity 0.2s ease-in-out;
	}

	.notify-button-star {
		transition: opacity 0.2s ease-in-out;
	}

	.notify-button-stream {
		transition: opacity 0.2s ease-in-out;
	}

	@media (prefers-reduced-motion: no-preference) {
		.notify-button-space {
			animation: notify-button-space 3s linear infinite;
		}

		.notify-button-star {
			animation: notify-button-star 2s ease-in-out infinite var(--delay);
		}

		.notify-button-stream {
			animation: notify-button-stream 2s ease-in-out infinite;
		}

		.notify-button-plane {
			animation: notify-button-plane 2s ease-in-out infinite;
		}
	}

	.notify-button-button:hover {
		.notify-button-space,
		.notify-button-star,
		.notify-button-stream {
			opacity: 100%;
		}
	}

	:global(.lenis.lenis-scrolling) .ring-rotor {
		animation-play-state: paused;
	}

	@media screen and (width >= 768px) {
		.notify-button-space,
		.notify-button-star,
		.notify-button-stream {
			opacity: 0%;
		}

		.notify-button-plane,
		.notify-button-stream {
			animation: none;
		}

		.notify-button-button:hover {
			.notify-button-stream {
				opacity: 100%;
				animation: notify-button-stream 2s ease-in-out infinite;
			}

			.notify-button-plane {
				animation: notify-button-plane 2s ease-in-out infinite;
			}
		}
	}

	@keyframes notify-button-star {
		0% {
			transform: scale(1);
		}

		50% {
			transform: scale(0);
		}

		100% {
			transform: scale(1);
		}
	}

	@keyframes notify-button-plane {
		0% {
			transform: translateY(-3px);
		}

		50% {
			transform: translateY(3px);
		}

		100% {
			transform: translateY(-3px);
		}
	}

	@keyframes notify-button-stream {
		0% {
			transform: translateY(-1px);
		}

		50% {
			transform: translateY(1px);
		}

		100% {
			transform: translateY(-1px);
		}
	}

	@keyframes notify-button-space {
		0% {
			transform: translate(0);
		}

		100% {
			transform: translate(-50px, 50px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.notify-button-space,
		.notify-button-star,
		.notify-button-stream,
		.notify-button-plane,
		.ring-rotor {
			animation: none !important;
		}
	}
</style>
