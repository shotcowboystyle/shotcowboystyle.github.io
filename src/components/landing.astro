---
import About from '@/components/about/about.astro';
import ExperimentsPlate from '@/components/experiments-plate.astro';
// import MysteryBox from '@/components/about/mystery-box.astro';
import HeaderContent from '@/components/header-content.astro';
import ProjectCard from '@/components/project-card.astro';
import { getProjects, plateBackground } from '@/lib/projects';

const projects = await getProjects();
---

<section
	id="header"
	aria-labelledby="header-headline"
	class="js-section-card-wrapper relative -mb-[100vh] h-[250vh]"
>
	<div
		class="js-section-card sticky top-0 flex min-h-screen w-full overflow-hidden p-4 sm:p-8 lg:p-6"
	>
		<HeaderContent />
	</div>
</section>

<section
	id="project-cards"
	aria-label="Selected projects"
	class="relative h-full w-full"
>
	{
		projects.map((project) => (
			<article
				id={`work-${project.id}`}
				data-folio-slug={project.id}
				class="project-card js-section-card-wrapper relative -mb-[100vh] h-[250vh]"
			>
				<div class="sticky top-0 flex min-h-screen w-full overflow-hidden p-4 sm:p-8 lg:p-6">
					{/*
					 * No padding on the plate itself: the card art is positioned against
					 * this box, so padding here inset every image and left the plate color
					 * showing as a hard-edged frame around the artwork. Content padding
					 * now lives inside `ProjectCard`, applied to the copy only.
					 */}
					<div
						class="js-section-card relative flex w-full flex-1 flex-col justify-end overflow-hidden rounded-2xl sm:rounded-3xl"
						style={plateBackground(project.data)}
					>
						{/*
						 * The project's art, outside the plate-turn so the hover tilt opens
						 * onto it rather than onto a flat edge. Its ground is `cardColor`, so
						 * nothing shifts while it loads.
						 */}
						{project.data.cardBg && (
							<picture>
								{project.data.cardBgMobile && (
									<source
										media="(max-width: 767px)"
										srcset={project.data.cardBgMobile.src}
									/>
								)}
								<img
									src={project.data.cardBg.src}
									alt=""
									loading="lazy"
									decoding="async"
									class="js-card-bg pointer-events-none absolute inset-0 h-full w-full object-cover"
								/>
							</picture>
						)}
						<ProjectCard project={project} />
					</div>
				</div>
			</article>
		))
	}
</section>

<ExperimentsPlate />

<section
	id="about"
	aria-label="About Curtis"
	class="relative"
>
	<About />
</section>

<!-- <footer
	aria-label="Extras"
	class="relative px-5 pb-5 sm:px-8 sm:pb-8 lg:px-6 lg:pb-6"
>
	<h2 class="sr-only">Miscellany</h2>
	{
		/*
		 * A definite height, not `min-height`. The mystery box's root carries
		 * `h-full`, and a percentage height against an auto-height parent resolves to
		 * auto — so the card collapsed to 0px and the whole easter egg, all four
		 * links included, rendered inside a zero-height box.
		 */
	}
	<div class="relative h-[220px] overflow-hidden rounded-2xl sm:h-[300px] sm:rounded-3xl">
		<MysteryBox />
	</div>
</footer> -->

<script>
	import { prefersReducedMotion } from '../utils/motion.ts';

	/**
	 * The stacked-card layout is pure CSS (`sticky` + `-mb-[100vh]`), so
	 * skipping the scrub only removes the scale-and-fade exit. The sections
	 * still stack and scroll, which is the point of PRODUCT.md's rule that
	 * reduced motion must still communicate hierarchy.
	 */
	if (!prefersReducedMotion()) {
		void import('../lib/section-card-scroll-animation.ts').then((module) => new module.default());
	}

	/**
	 * Split entrances, the scroll reveals, and the ambient wave on the hero
	 * headline. Each split is reverted as its entrance finishes, so a later
	 * resize re-measures from clean markup rather than from captured lines.
	 */
	void import('../lib/heading-motion.ts').then((module) => new module.default());

	/*
	 * The fixed Index pill stays out of the hero, which has its own Index link
	 * and, on a phone, no room for the pill beside Let's Talk. It arrives once
	 * the first plate has come halfway up over the hero, and stays for the rest
	 * of the page.
	 */
	const firstPlate = document.querySelector('#project-cards > article');
	if (firstPlate) {
		// A scroll listener rather than an IntersectionObserver: an anchor jump or a
		// restored scroll position can skip clean over the plate without ever
		// changing its intersection, and the pill would stay hidden.
		const update = () =>
			document.documentElement.classList.toggle(
				'past-hero',
				firstPlate.getBoundingClientRect().top < window.innerHeight / 2,
			);
		window.addEventListener('scroll', update, { passive: true });
		update();
	}
</script>
