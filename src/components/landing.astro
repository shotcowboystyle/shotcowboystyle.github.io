---
import About from '@/components/about/about.astro';
import MysteryBox from '@/components/about/mystery-box.astro';
import HeaderContent from '@/components/header-content.astro';
import ProjectCard from '@/components/project-card.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('project');
---

<section
	id="header"
	aria-labelledby="header-headline"
	class="js-section-card-wrapper relative -mb-[100vh] h-[250vh]"
>
	<div
		class="js-section-card h-full-mobile sticky top-0 flex min-h-screen w-full overflow-hidden p-4 sm:p-8 lg:p-6"
	>
		<HeaderContent />
	</div>
</section>

<section
	id="project-cards"
	aria-label="Selected projects"
	class="relative h-full w-full"
>
	{
		projects.map((project, idx) => (
			<article
				id={`project-card_${idx + 1}`}
				class="project-card js-section-card-wrapper relative -mb-[100vh] h-[250vh]"
			>
				<div class="h-full-mobile sticky top-0 flex min-h-screen w-full overflow-hidden p-4 sm:p-8 lg:p-6">
					{/*
					 * No padding on the plate itself: the card art is positioned against
					 * this box, so padding here inset every image and left the plate color
					 * showing as a hard-edged frame around the artwork. Content padding
					 * now lives inside `ProjectCard`, applied to the copy only.
					 */}
					<div
						class="js-section-card sticky flex w-full flex-1 flex-col justify-end overflow-hidden rounded-2xl sm:rounded-3xl"
						style={`background-color: ${project.data.cardColor};`}
					>
						<ProjectCard project={project} />
					</div>
				</div>
			</article>
		))
	}
</section>

<section
	id="about"
	aria-label="About Curtis"
	class="relative"
>
	<About />
</section>

<footer
	aria-label="Extras"
	class="relative px-5 pb-5 sm:px-8 sm:pb-8 lg:px-6 lg:pb-6"
>
	<h2 class="sr-only">Miscellany</h2>
	{
		/*
		 * A definite height, not `min-height`. The mystery box's root carries
		 * `h-full`, and a percentage height against an auto-height parent resolves to
		 * auto — so the card collapsed to 0px and the whole easter egg, all four
		 * links included, rendered inside a zero-height box.
		 */
	}
	<div class="relative h-[220px] overflow-hidden rounded-2xl sm:h-[300px] sm:rounded-3xl">
		<MysteryBox />
	</div>
</footer>

<script>
	import { registerTransitionModule } from '@/utils/module-loader';

	registerTransitionModule(async () => {
		const { prefersReducedMotion } = await import('../utils/motion.ts');

		/**
		 * The stacked-card layout is pure CSS (`sticky` + `-mb-[100vh]`), so
		 * skipping the scrub only removes the scale-and-fade exit. The sections
		 * still stack and scroll, which is the point of PRODUCT.md's rule that
		 * reduced motion must still communicate hierarchy.
		 */
		const sectionCardScroll = prefersReducedMotion()
			? null
			: await import('../lib/section-card-scroll-animation.ts').then(
					(module) => new module.default(),
				);

		const textSplit = await import('../lib/text-split/index.ts').then(
			(module) => new module.default(),
		);
		const textReveal = await import('../lib/text-reveal.ts').then((module) => new module.default());
		textReveal.animate();

		/**
		 * Lines are measured once, and `.split-line-parent` clips to a fixed
		 * `1em`. When the viewport narrows — a rotation, a window drag, a zoom
		 * step — the captured lines rewrap to two visual lines inside a
		 * one-line box and the heading overlaps and clips itself. Re-splitting
		 * against the new width is what keeps the text reachable.
		 *
		 * Width only: mobile browsers fire `resize` constantly as the URL bar
		 * shows and hides, and re-splitting on that would be pure churn.
		 */
		const { debounce } = await import('../utils/debounce.ts');

		let lastWidth = window.innerWidth;

		const resplit = debounce(() => {
			if (window.innerWidth === lastWidth) {
				return;
			}

			lastWidth = window.innerWidth;

			textReveal.destroy();
			textSplit.destroy();
			textSplit.init();
			textReveal.animate();
		}, 200);

		window.addEventListener('resize', resplit);

		return () => {
			window.removeEventListener('resize', resplit);
			sectionCardScroll?.destroy();
			textReveal.destroy();
			textSplit.destroy();
		};
	});
</script>
