---
const { class: className } = Astro.props;
---

<div class:list={['container', className]}>
	<div
		class="resizable"
		id="resize-me"
	>
		<slot />
		<div
			class="resizer resizer-r"
			role="separator"
			tabindex="0"
			aria-orientation="vertical"
			aria-label="Resize the frame width"
		>
		</div>
		<div
			class="resizer resizer-b"
			role="separator"
			tabindex="0"
			aria-orientation="horizontal"
			aria-label="Resize the frame width"
		>
		</div>
	</div>
</div>

<script>
	document.addEventListener('astro:page-load', () => {
		const el = document.getElementById('resize-me');
		if (!el) {
			return;
		}

		// The current position of mouse/touch
		let cx = 0;

		// The dimension of the element
		let w = 0;

		const COARSE_POINTER_MIN_WIDTH = 327;
		const FINE_POINTER_MIN_WIDTH = 654;

		/** Arrow keys nudge; Shift+arrow covers ground faster. */
		const KEYBOARD_STEP = 16;
		const KEYBOARD_LARGE_STEP = 64;

		const resizers = el.querySelectorAll<HTMLElement>('.resizer');

		const minWidthFor = (isTouchEvent: boolean) =>
			isTouchEvent ? COARSE_POINTER_MIN_WIDTH : FINE_POINTER_MIN_WIDTH;

		const maxWidth = () => el.parentElement?.clientWidth ?? window.innerWidth;

		/**
		 * Single place that writes the width, so the drag and the keyboard path
		 * cannot drift apart. Also mirrors the value onto the separators, which
		 * is what a screen reader reads out while stepping.
		 */
		const applyWidth = (next: number, minWidth: number) => {
			const clamped = Math.min(Math.max(next, minWidth), maxWidth());

			el.style.width = `${clamped}px`;
			document.body.classList.toggle('is-resize-limit', clamped <= minWidth);

			resizers.forEach((resizer) => {
				resizer.setAttribute('aria-valuenow', String(Math.round(clamped)));
				resizer.setAttribute('aria-valuemin', String(minWidth));
				resizer.setAttribute('aria-valuemax', String(Math.round(maxWidth())));
			});

			return clamped;
		};

		function onTouchDown(e: TouchEvent) {
			onDown(e.touches[0]);
			e.preventDefault();
		}

		function onTouchMove(e: TouchEvent) {
			onMove(e.touches[0], true);
		}

		function onTouchEnd(e: TouchEvent) {
			if (e.touches.length == 0) {
				onUp();
			}
		}

		const onMove = (e: MouseEvent | Touch, isTouchEvent: boolean = false) => {
			// How far the mouse has been moved
			const dx = e.clientX - cx;

			applyWidth(w + dx, minWidthFor(isTouchEvent));
		};

		// Handle the mousedown event
		// that's triggered when user drags the resizer
		const onDown = (e: MouseEvent | Touch) => {
			// Get the current mouse position
			cx = e.clientX;

			// Calculate the dimension of element
			const styles = window.getComputedStyle(el);
			w = parseInt(styles.width, 10);

			// Attach the listeners to document
			document.addEventListener('mousemove', onMove);
			document.addEventListener('mouseup', onUp);
			document.addEventListener('touchmove', onTouchMove);
			document.addEventListener('touchend', onTouchEnd);
		};

		const onUp = () => {
			// Remove the handlers of mousemove and mouseup
			document.removeEventListener('mousemove', onMove);
			document.removeEventListener('mouseup', onUp);
			document.removeEventListener('touchmove', onTouchMove);
			document.removeEventListener('touchend', onTouchEnd);
		};

		/**
		 * Keyboard equivalent of the drag. Without it the whole point of this
		 * page — resizing the frame — was reachable by pointer only.
		 */
		const onKeyDown = (event: KeyboardEvent) => {
			const minWidth = minWidthFor(window.matchMedia('(pointer: coarse)').matches);
			const current = parseInt(window.getComputedStyle(el).width, 10);
			const step = event.shiftKey ? KEYBOARD_LARGE_STEP : KEYBOARD_STEP;

			let next: number;
			switch (event.key) {
				case 'ArrowLeft':
					next = current - step;
					break;
				case 'ArrowRight':
					next = current + step;
					break;
				case 'Home':
					next = minWidth;
					break;
				case 'End':
					next = maxWidth();
					break;
				default:
					return;
			}

			event.preventDefault();
			applyWidth(next, minWidth);
		};

		// Loop over them
		resizers.forEach((resizer) => {
			resizer.addEventListener('mousedown', onDown);
			resizer.addEventListener('touchstart', onTouchDown);
			resizer.addEventListener('keydown', onKeyDown);
		});

		applyWidth(
			parseInt(window.getComputedStyle(el).width, 10),
			minWidthFor(window.matchMedia('(pointer: coarse)').matches),
		);
	});
</script>

<style>
	@reference "../styles/base.css";

	.resizable {
		@apply relative w-full items-center justify-center border border-gray-300;
	}

	.resizer {
		@apply absolute;
	}

	/* Placed at the right side */
	.resizer-r {
		@apply top-0 right-0 h-full w-1 cursor-col-resize;
	}

	/* Placed at the bottom side */
	.resizer-b {
		@apply bottom-0 left-0 h-1 w-full cursor-row-resize;
	}

	/* Optional styles */
	.container {
		@apply min-h-fit p-4;
	}
</style>
