---
import type { PageMetaData } from '@/types';

export type Props = {
	meta?: PageMetaData;
};

const {
	meta = {
		title: 'Curtis Blanton — Full Stack Senior Developer',
		description:
			'Motion is the language. Fifteen years of shipping considered work for teams that treat craft as evidence.',
	},
} = Astro.props;

/**
 * The share image used to be `${Astro.url}socialImage.webp`, which concatenated
 * without a separator: the path segment and the filename ran together into one
 * word, and it pointed at a file that does not exist.
 * Pages may now supply their own image; everything else falls back to the real
 * asset in `public/img`.
 */
const origin = Astro.site ?? Astro.url;
const shareImage = new URL(meta.image ?? '/img/og.webp', origin).href;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogType = meta.type ?? 'website';
---

<!-- Open Graph -->
<meta
	property="og:url"
	content={canonical}
/>
<meta
	property="og:type"
	content={ogType}
/>
<meta
	property="og:title"
	content={meta.title}
/>
<meta
	name="description"
	property="og:description"
	content={meta.description}
/>
<meta
	property="og:image"
	content={shareImage}
/>

<!-- Twitter -->
<meta
	name="twitter:card"
	content="summary_large_image"
/>
<meta
	property="twitter:domain"
	content="shotcowboystyle.github.io"
/>
<meta
	property="twitter:url"
	content={canonical}
/>
<meta
	name="twitter:title"
	content={meta.title}
/>
<meta
	name="twitter:description"
	content={meta.description}
/>
<meta
	name="twitter:image"
	content={shareImage}
/>
