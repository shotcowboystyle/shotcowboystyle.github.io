---
/**
 * The single way back from any secondary page.
 *
 * This used to be two different things: a text link on the case studies and a
 * 56px icon-only circle on `/immature` and `/tower-blocks`. The circle depended
 * on the SVG sprite resolving, carried its label only in `.sr-only` text, and on
 * `/tower-blocks` was drawn in black on what is now a black canvas. One labelled
 * text link works on every surface and states where it goes.
 *
 * `tone` picks the ink, not the layout: `ink` for the mint masthead, `canvas`
 * for the black pages.
 */
interface Props {
	tone?: 'ink' | 'canvas';
}

const { tone = 'ink' } = Astro.props;
---

<a
	href="/"
	class:list={['back-link', `back-link-${tone}`]}
	data-astro-prefetch
>
	<span
		class="back-link-arrow"
		aria-hidden="true"
		>←</span
	>
	<span class="back-link-label">Back to portfolio</span>
</a>

<style>
	@reference "../styles/base.css";

	.back-link {
		display: inline-flex;
		gap: 0.6rem;
		align-items: center;
		font-weight: 600;
		font-size: var(--text-xs);
		font-family: var(--font-sans);
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	/* `primary-ink` is the on-mint ink — it measured 1.38:1 on black, so the
	   black-canvas pages get the off-white instead. */
	.back-link-ink {
		color: oklch(25% 0.08 160deg);
	}

	.back-link-canvas {
		color: oklch(91% 0 0deg);
	}

	.back-link-arrow {
		display: inline-block;
		transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
	}

	.back-link:hover .back-link-arrow,
	.back-link:focus-visible .back-link-arrow {
		transform: translateX(-3px);
	}

	.back-link-label {
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
		transition: border-color 0.25s ease-out;
	}

	.back-link:hover .back-link-label,
	.back-link:focus-visible .back-link-label {
		border-bottom-color: currentColor;
	}

	@media (prefers-reduced-motion: reduce) {
		.back-link-arrow,
		.back-link-label {
			transition: none;
		}
	}
</style>
