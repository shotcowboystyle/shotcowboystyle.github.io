---
import SiteVerification from '@/components/common/site-verification.astro';
import Favicons from '@/components/favicons.astro';
import OpenGraph from '@/components/open-graph.astro';
import Seo from '@/components/seo.astro';
import SiteIndex from '@/components/site-index.astro';
import viewTransitionScript from '@/lib/view-transition.js?raw';
import type { PageMetaData } from '@/types';
import '@/styles/base.css';

export type Props = {
	meta?: PageMetaData;
};

const DEFAULT_META = {
	title: 'Curtis Blanton — Full Stack Senior Developer',
	description:
		'Motion is the language. Fifteen years of shipping considered work for teams that treat craft as evidence.',
} satisfies PageMetaData;

/**
 * Merged rather than replaced, so a page that supplies only a title still gets
 * a description instead of emitting an empty `<meta name="description">`.
 */
const meta: PageMetaData = { ...DEFAULT_META, ...Astro.props.meta };
---

<!doctype html>
<html
	dir="ltr"
	lang="en"
>
	<head>
		<script is:inline>
			document.documentElement.classList.toggle(
				'has-motion',
				!window.matchMedia('(prefers-reduced-motion: reduce)').matches,
			);
		</script>

		<script
			is:inline
			set:html={viewTransitionScript}
		/>

		<link
			rel="preload"
			href="/fonts/Thunder-VF.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/GeneralSans-Variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>

		<Seo />
		<Favicons />
		<title>{meta.title}</title>
		<OpenGraph meta={meta} />
		<SiteVerification />

		<script
			is:inline
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="1427b780-3626-4e70-87a5-09b06ce64b8e"
			data-domains="shotcowboystyle.github.io"
		></script>

		<slot name="head-end" />
	</head>

	<body
		class="selection:text-base-neutral text-base-content m-0 min-h-full bg-black font-sans leading-normal font-medium selection:bg-rose-200"
	>
		<a
			href="#main"
			class="skip-to-content"
		>
			Skip to main content
		</a>

		<SiteIndex />

		<main
			id="main"
			tabindex="-1"
		>
			<slot />
		</main>

		<div
			class="report"
			id="report"
		>
		</div>

		<slot name="body-end" />

		<script>
			import { swMessage } from '@/utils/report';

			function initialize() {
				if (navigator.serviceWorker) {
					navigator.serviceWorker.addEventListener('message', (e) => swMessage(e));
				}

				if (sessionStorage.getItem('session-started-at')) {
					return;
				}
				sessionStorage.setItem('session-started-at', new Date().toString());
			}

			document.addEventListener(
				'DOMContentLoaded',
				() => {
					initialize();
				},
				{ once: true },
			);
		</script>
	</body>
</html>
