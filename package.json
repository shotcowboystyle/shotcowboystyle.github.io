{
	"name": "shotcowboystyle.github.io",
	"description": "Personal site for Curtis Blanton. Hooray! ✨",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"author": {
		"name": "Curtis Blanton",
		"url": "https://shotcowboystyle.github.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/shotcowboystyle/shotcowboystyle.github.io"
	},
	"license": "MIT",
	"packageManager": "pnpm@12.3.2",
	"engines": {
		"node": ">=25"
	},
	"scripts": {
		"postprepare": "lefthook install",
		"astro": "astro",
		"build": "astro build",
		"clean": "rm -rf .astro dist lighthouse node_modules stats.html .eslintcache .stylelintcache .cspellcache",
		"dev": "astro dev",
		"format:check": "prettier '**/*.{tsx,ts,mjs,cjs,js,json,css,yml,yaml,md,astro}' --check",
		"format:fix": "prettier '**/*.{tsx,ts,mjs,cjs,js,json,css,yml,yaml,md,astro}' --write",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "eslint .",
		"lint:code:fix": "eslint . --fix",
		"lint:manifest:check": "npmPkgJsonLint .",
		"lint:packages:check": "pnpm dedupe --check",
		"lint:knip:check": "knip --config knip.config.mjs",
		"lint:spelling:check": "cspell lint './**/*.{tsx,ts,mjs,cjs,js,json,css,yml,yaml,md,astro}' --gitignore --cache",
		"lint:styles:check": "stylelint src/**/*.{astro,css} --cache --ignore-pattern .gitignore",
		"lint:styles:fix": "stylelint src/**/*.{astro,css} --cache --ignore-pattern .gitignore --fix",
		"preview": "astro preview",
		"test": "run-s test:unit test:e2e:*",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e:accessibility": "playwright test e2e/tests/accessibility",
		"test:e2e:pages": "playwright test e2e/tests/pages",
		"test:e2e:performance": "playwright test e2e/tests/performance",
		"test:playwright:codegen": "playwright codegen",
		"test:playwright:debug": "playwright test --debug",
		"test:playwright:ui": "playwright test --ui",
		"types:check": "astro sync && tsc --noEmit && astro check",
		"validate": "run-p format:check lint:check types:check test"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^6.4.8",
		"astro-svgs": "^1.2.2",
		"astro-sw": "^1.0.5",
		"cannon": "^0.6.2",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"lottie-web": "^5.13.0",
		"maplibre-gl": "^5.24.0",
		"sharp": "^0.35.4",
		"split-type": "^0.3.4",
		"three": "^0.185.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/ts-plugin": "^1.10.11",
		"@axe-core/playwright": "^4.13.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@eslint/markdown": "^8.0.3",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/cannon": "^0.1.13",
		"@types/eslint": "^9.6.1",
		"@types/three": "^0.185.4",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"@vitest/coverage-v8": "^4.1.11",
		"astro-compress": "2.4.3",
		"astro-critters": "^2.2.1",
		"astro-eslint-parser": "^1.4.0",
		"astro-purgecss": "^6.0.1",
		"ci-info": "^4.4.0",
		"commitizen": "^4.3.2",
		"cspell": "^10.2.1",
		"cz-conventional-changelog": "^3.3.0",
		"daisyui": "^5.7.28",
		"eslint": "^10.9.1",
		"eslint-plugin-astro": "^3.1.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.0",
		"knip": "^6.34.0",
		"lefthook": "2.1.12",
		"lighthouse": "^13.4.1",
		"npm-package-json-lint": "^11.0.0",
		"npm-package-json-lint-config-default": "^10.0.0",
		"npm-run-all2": "^9.0.3",
		"playwright": "^1.62.1",
		"playwright-lighthouse": "^4.0.0",
		"postcss": "^8.5.26",
		"postcss-html": "^2.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rollup-plugin-analyzer": "^4.0.0",
		"rollup-plugin-visualizer": "^7.1.1",
		"stylelint": "^17.14.1",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-hudochenkov": "^13.0.2",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-tailwindcss": "^1.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
